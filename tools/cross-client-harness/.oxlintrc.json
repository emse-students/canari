{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "plugins": ["import", "unicorn"],
  "env": {
    "browser": false,
    "node": true
  },
  "globals": {
    "Bun": "readonly"
  },
  "ignorePatterns": ["logs/**", "node_modules/**"],
  "rules": {
    "eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "eslint/no-undef": "error"
  }
}
