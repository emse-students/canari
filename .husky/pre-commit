#!/bin/sh
# Pre-commit hook - auto-fixes and re-stages rather than blocking.

[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
export PATH="$HOME/.cargo/bin:$PATH"

STAGED_FILES=$(git diff --cached --name-only)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# Re-stage the auto-fixer's output for the files THIS COMMIT ALREADY STAGED, and no others.
#
# This used to be `git diff --name-only -- <dir> | xargs -r git add`, which re-stages everything
# dirty under the directory - including work a parallel session, or the developer's own unrelated
# edit, had deliberately left out. A commit then silently carries files its author never chose, and
# nothing reports it: the hook's job is to fix what is being committed, not to decide what is.
# The allowlist is $STAGED_FILES, captured before any fixer ran.
#
# `git add -A --` rather than `git add --`, so a staged DELETION survives the round trip instead of
# failing the pathspec.
restage() {
  echo "$STAGED_FILES" | grep -E "^$1" | while IFS= read -r staged_path; do
    [ -n "$staged_path" ] && git add -A -- "$staged_path"
  done
}

echo "$STAGED_FILES" | grep -Eq '^(\.github/workflows/|\.husky/|Makefile|libs/shared-rust/)' && RUN_ALL=1 || RUN_ALL=0
echo "$STAGED_FILES" | grep -Eq '^frontend/' && RUN_FRONTEND=1 || RUN_FRONTEND=0
echo "$STAGED_FILES" | grep -Eq '^apps/chat-delivery-service/' && RUN_DELIVERY=1 || RUN_DELIVERY=0
echo "$STAGED_FILES" | grep -Eq '^apps/chat-gateway/' && RUN_GATEWAY=1 || RUN_GATEWAY=0
echo "$STAGED_FILES" | grep -Eq '^apps/social-service/' && RUN_SOCIAL=1 || RUN_SOCIAL=0
echo "$STAGED_FILES" | grep -Eq '^apps/core-service/' && RUN_CORE=1 || RUN_CORE=0
echo "$STAGED_FILES" | grep -Eq '^apps/media-service/' && RUN_MEDIA=1 || RUN_MEDIA=0
# Rust crates under frontend/ are not covered by the JS checks of the frontend block above.
# cargo fmt is mandatory there: the CI job `cargo fmt -- --check` breaks the CD otherwise.
echo "$STAGED_FILES" | grep -Eq '^frontend/mls-core/' && RUN_MLS_CORE=1 || RUN_MLS_CORE=0
echo "$STAGED_FILES" | grep -Eq '^frontend/mls-wasm/' && RUN_MLS_WASM=1 || RUN_MLS_WASM=0
echo "$STAGED_FILES" | grep -Eq '^frontend/src-tauri/' && RUN_TAURI=1 || RUN_TAURI=0

if [ "$RUN_ALL" -eq 1 ]; then
  RUN_FRONTEND=1
  RUN_DELIVERY=1
  RUN_GATEWAY=1
  RUN_SOCIAL=1
  RUN_CORE=1
  RUN_MEDIA=1
  RUN_MLS_CORE=1
  RUN_MLS_WASM=1
  RUN_TAURI=1
fi

if [ "$RUN_FRONTEND" -eq 1 ]; then
  (cd frontend && bun run lint:fix && bun run format) || {
    echo "❌ Frontend lint/format failed."
    exit 1
  }
  restage "frontend"
  # Mirror exactly the CI lint job (lint + check + format:check) so nothing
  # broken can reach CD. Auto-fix already ran above; these are the strict gates.
  (cd frontend && bun run check -- --threshold warning && bun run lint && bun run format:check) || {
    echo "❌ Frontend checks failed (svelte-check / oxlint / oxvelte / format:check)."
    exit 1
  }
fi

if [ "$RUN_DELIVERY" -eq 1 ]; then
  (cd apps/chat-delivery-service && bun run lint:fix) || {
    echo "❌ chat-delivery-service lint failed."
    exit 1
  }
  restage "apps/chat-delivery-service"
fi

if [ "$RUN_GATEWAY" -eq 1 ]; then
  (cd apps/chat-gateway && cargo fmt) || {
    echo "❌ chat-gateway cargo fmt failed."
    exit 1
  }
  restage "apps/chat-gateway"
fi

if [ "$RUN_SOCIAL" -eq 1 ]; then
  (cd apps/social-service && bun run lint:fix) || {
    echo "❌ social-service lint failed."
    exit 1
  }
  restage "apps/social-service"
fi

if [ "$RUN_CORE" -eq 1 ]; then
  (cd apps/core-service && bun run lint:fix) || {
    echo "❌ core-service lint failed."
    exit 1
  }
  restage "apps/core-service"
fi

if [ "$RUN_MEDIA" -eq 1 ]; then
  (cd apps/media-service && bun run lint:fix) || {
    echo "❌ media-service lint failed."
    exit 1
  }
  restage "apps/media-service"
fi

# Rust crates under frontend/: auto-format (cargo fmt) then re-stage, like chat-gateway.
# Catches the formatting problem at commit time instead of letting it break the CD.
if [ "$RUN_MLS_CORE" -eq 1 ]; then
  (cd frontend/mls-core && cargo fmt) || {
    echo "❌ mls-core cargo fmt failed."
    exit 1
  }
  restage "frontend/mls-core"
fi

if [ "$RUN_MLS_WASM" -eq 1 ]; then
  (cd frontend/mls-wasm && cargo fmt) || {
    echo "❌ mls-wasm cargo fmt failed."
    exit 1
  }
  restage "frontend/mls-wasm"
fi

if [ "$RUN_TAURI" -eq 1 ]; then
  (cd frontend/src-tauri && cargo fmt) || {
    echo "❌ src-tauri cargo fmt failed."
    exit 1
  }
  restage "frontend/src-tauri"
fi

exit 0
