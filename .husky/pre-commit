#!/bin/sh
# Pre-commit hook - auto-fixes and re-stages, and does NOTHING that only reports.
#
# REDUCED ON 2026-09-02, WHEN THE PROJECT MOVED TO PULL REQUESTS (user: "Cela evite les hooks tres
# longs"). It used to mirror the CI lint job as well - `svelte-check`, strict `oxlint`,
# `format:check` - which meant every commit paid two to three minutes to learn something the pull
# request was about to say anyway. What it keeps is the half a hook is actually good at: FIXING.
# `lint:fix`, `format` and `cargo fmt` all rewrite files, so running them at commit time is the
# difference between a clean diff and a CI failure about whitespace. Everything that merely REPORTS
# now lives in `ci.yml`, which runs on the pull request and again at merge on `main`.
#
# `.husky/pre-push` WAS DELETED THE SAME DAY, and its four unique gates were moved into CI FIRST -
# `make test-harness`, the real `wasm32` build, clippy, the frontend suite were already there, and
# the two that were NOT were added before the hook went: `cargo fmt --check` on `frontend/src-tauri`
# (its only caller was that hook) and `format:check` on the four NestJS services (only
# `chat-delivery-service` had a caller, and it was that hook too). Deleting first would have opened
# exactly the hole those hooks' own comments were written to close.
#
# WHY `format` IS NOW RUN FOR THE SERVICES TOO, and was not before: CI gates their formatting since
# 2026-09-02, so a service commit that is not formatted is a red pull request. The fixer belongs
# where the file is written.

[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
export PATH="$HOME/.cargo/bin:$PATH"

STAGED_FILES=$(git diff --cached --name-only)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# Re-stage the auto-fixer's output for the files THIS COMMIT ALREADY STAGED, and no others.
#
# This used to be `git diff --name-only -- <dir> | xargs -r git add`, which re-stages everything
# dirty under the directory - including work a parallel session, or the developer's own unrelated
# edit, had deliberately left out. A commit then silently carries files its author never chose, and
# nothing reports it: the hook's job is to fix what is being committed, not to decide what is.
# The allowlist is $STAGED_FILES, captured before any fixer ran.
#
# A STAGED DELETION IS SKIPPED, NOT RE-ADDED. `git add -A -- <path>` was believed to carry one
# through, and it does not: once `git rm` has taken the path out of the INDEX and the fixers have no
# file to touch in the WORKTREE either, the pathspec matches nothing anywhere and git exits 128 -
# which failed a whole commit on 2026-08-31 for deleting a dead test. Nothing needs re-staging in
# that case: no formatter can have rewritten a file that is not there, and the deletion is already
# in the index exactly as its author staged it. The `-e` test is the whole fix, and it is a test
# rather than a swallowed error on purpose - a `|| true` here would also hide a real failure.
restage() {
  echo "$STAGED_FILES" | grep -E "^$1" | while IFS= read -r staged_path; do
    [ -z "$staged_path" ] && continue
    [ -e "$staged_path" ] || continue
    git add -A -- "$staged_path"
  done
}

# A change to the shared plumbing fixes everything, because it can reformat anything.
echo "$STAGED_FILES" | grep -Eq '^(\.github/workflows/|\.husky/|Makefile)' && RUN_ALL=1 || RUN_ALL=0

# Every bun package that declares `lint:fix` and `format`, and the directory each one owns.
BUN_PACKAGES="frontend apps/chat-delivery-service apps/core-service apps/media-service apps/social-service"
# Every Rust crate: `cargo fmt` rewrites, and CI runs `cargo fmt -- --check` on all of them.
RUST_CRATES="apps/chat-gateway apps/call-service frontend/mls-core frontend/mls-wasm frontend/src-tauri"

for pkg in $BUN_PACKAGES; do
  if [ "$RUN_ALL" -eq 1 ] || echo "$STAGED_FILES" | grep -Eq "^$pkg/"; then
    (cd "$pkg" && bun run lint:fix && bun run format) || {
      echo "❌ $pkg: lint:fix / format failed."
      exit 1
    }
    restage "$pkg"
  fi
done

for crate in $RUST_CRATES; do
  if [ "$RUN_ALL" -eq 1 ] || echo "$STAGED_FILES" | grep -Eq "^$crate/"; then
    (cd "$crate" && cargo fmt) || {
      echo "❌ $crate: cargo fmt failed."
      exit 1
    }
    restage "$crate"
  fi
done

exit 0
