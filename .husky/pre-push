#!/bin/sh
# Pre-push hook for Canari project
# Prevent pushing dirty worktrees and run checks only for impacted projects

[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
export PATH="$HOME/.cargo/bin:$PATH"

if ! git diff --cached --quiet; then
  echo "❌ Push blocked: files are staged but not committed."
  echo "   Commit or stash them before pushing."
  exit 1
fi

# `|| true`: with no upstream (a `push -u` of a fresh branch) git rev-parse exits 128.
# The husky wrapper runs this hook under `sh -e`, so a failing substitution would kill
# the script before any check. We fall back to the diff-tree of HEAD instead.
UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || true)
if [ -n "$UPSTREAM" ]; then
  CHANGED_FILES=$(git diff --name-only "$UPSTREAM"...HEAD)
else
  CHANGED_FILES=$(git diff-tree --no-commit-id --name-only -r HEAD)
fi

if [ -z "$CHANGED_FILES" ]; then
  exit 0
fi

echo "$CHANGED_FILES" | grep -Eq '^(\.github/workflows/|\.husky/|Makefile|libs/shared-rust/)' && RUN_ALL=1 || RUN_ALL=0
echo "$CHANGED_FILES" | grep -Eq '^frontend/' && RUN_FRONTEND=1 || RUN_FRONTEND=0
echo "$CHANGED_FILES" | grep -Eq '^apps/chat-delivery-service/' && RUN_DELIVERY=1 || RUN_DELIVERY=0
echo "$CHANGED_FILES" | grep -Eq '^apps/chat-gateway/' && RUN_GATEWAY=1 || RUN_GATEWAY=0
echo "$CHANGED_FILES" | grep -Eq '^frontend/mls-core/' && RUN_MLS_CORE=1 || RUN_MLS_CORE=0
echo "$CHANGED_FILES" | grep -Eq '^frontend/mls-wasm/' && RUN_MLS_WASM=1 || RUN_MLS_WASM=0
echo "$CHANGED_FILES" | grep -Eq '^frontend/src-tauri/' && RUN_TAURI=1 || RUN_TAURI=0

if [ "$RUN_ALL" -eq 1 ]; then
  RUN_FRONTEND=1
  RUN_DELIVERY=1
  RUN_GATEWAY=1
  RUN_MLS_CORE=1
  RUN_MLS_WASM=1
  RUN_TAURI=1
fi

# `bun run test` sits here and not in the pre-commit hook: ~2 min over 176 files, too expensive on
# every commit, but the frontend was the ONLY project whose hooks never ran its suite
# (chat-delivery-service has its `npm test` below, mls-wasm its real wasm32 build). An import cycle
# reached the CD through that hole: it breaks neither the lint nor svelte-check, it breaks at module
# EXECUTION, so only a test that imports could see it. The pre-commit hook mirrors the CI lint job;
# this mirrors its test job.
if [ "$RUN_FRONTEND" -eq 1 ]; then
  (
    cd frontend && bun run lint && bun run check && bun run format:check && bun run test
  ) || {
    echo "❌ Frontend checks failed (oxlint/oxvelte/check/format:check/test)."
    exit 1
  }
fi

# `npm test`, not `bun run test`: this suite is jest, and jest under the bun runtime fails
# `admin-storage.controller.mls.spec.ts` while it passes 8/8 under node (measured 2026-08-27).
# `ci.yml` splits the same way. Do not collapse this to one runtime without re-running that spec.
if [ "$RUN_DELIVERY" -eq 1 ]; then
  (
    cd apps/chat-delivery-service && bun run lint && bun run format:check && npm test
  ) || {
    echo "❌ chat-delivery-service checks failed (oxlint/format:check/test)."
    exit 1
  }
fi

if [ "$RUN_GATEWAY" -eq 1 ]; then
  (
    cd apps/chat-gateway && cargo fmt -- --check && cargo clippy --all-targets --all-features -- -D warnings
  ) || {
    echo "❌ chat-gateway checks failed (fmt/clippy)."
    exit 1
  }
fi

# Rust crates under frontend/: a strict mirror of the CI before pushing.
if [ "$RUN_MLS_CORE" -eq 1 ]; then
  (
    cd frontend/mls-core && cargo fmt -- --check && cargo clippy --all-targets -- -D warnings
  ) || {
    echo "❌ mls-core checks failed (fmt/clippy)."
    exit 1
  }
fi

# mls-wasm: fmt + a REAL BUILD for the wasm32 target (mirroring the CI's `wasm-pack build`). Host
# clippy does NOT cover wasm32-specific errors (getrandom/js feature, codegen); without this build a
# WASM breakage only appeared in CD. It is caught at pre-push now. A change to mls-core (a dependency
# of mls-wasm) triggers this build too.
if [ "$RUN_MLS_WASM" -eq 1 ] || [ "$RUN_MLS_CORE" -eq 1 ]; then
  (
    cd frontend/mls-wasm || exit 1
    cargo fmt -- --check || exit 1
    if ! rustup target list --installed 2>/dev/null | grep -q '^wasm32-unknown-unknown$'; then
      echo "⚠️  wasm32-unknown-unknown target missing - required to verify the WASM build."
      echo "    Install it: rustup target add wasm32-unknown-unknown"
      exit 1
    fi
    cargo build --target wasm32-unknown-unknown --quiet || exit 1
  ) || {
    echo "❌ mls-wasm checks failed (fmt / wasm32 build - mirror of the CI's wasm-pack)."
    exit 1
  }
fi

if [ "$RUN_TAURI" -eq 1 ]; then
  # fmt --check alone: src-tauri's clippy compiles the whole app plus deps - too heavy for a hook.
  (cd frontend/src-tauri && cargo fmt -- --check) || {
    echo "❌ src-tauri fmt check failed."
    exit 1
  }
fi

exit 0
