# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas/

# Generated by tauri_plugin::Builder in each in-repo plugin's build.rs, from the COMMANDS list
# there. The source of truth is that list plus the hand-written permissions/default.toml, both of
# which stay tracked; these are its outputs and nothing reads them - no capability file references
# the schema, and the ACL the app actually enforces is produced at build time.
#
# Tracking them cost a permanent flip-flop: the generator writes JSON expanded, the pre-commit
# formatter folds it back, so every Android build dirtied the tree and every commit undid it.
/plugins/*/permissions/autogenerated/
/plugins/*/permissions/schemas/

# WiX Toolset (Windows installer)
WixUI*.wixobj
WixUI*.wixpdb

# macOS
.DS_Store

# Rust
**/*.rs.bk

# IDE
.vscode/
.idea/

# Security
*.jks
*.keystore
keystore.properties

