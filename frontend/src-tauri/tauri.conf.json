{
  "productName": "Canari",
  "version": "1.4.1",
  "identifier": "fr.emse.canari",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Canari",
        "width": 800,
        "height": 600,
        "devtools": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost blob: https://canari.emse.fr wss://canari.emse.fr https://canari-emse.fr wss://canari-emse.fr https://www.canari-emse.fr wss://www.canari-emse.fr https://dev.canari-emse.fr wss://dev.canari-emse.fr",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "media-src": "'self' blob: https://canari.emse.fr https://canari-emse.fr https://www.canari-emse.fr https://dev.canari-emse.fr",
        "frame-src": "'self'",
        "form-action": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' http://localhost:1420 http://127.0.0.1:1420",
        "style-src": "'self' 'unsafe-inline' http://localhost:1420 http://127.0.0.1:1420",
        "connect-src": "'self' ipc: http://ipc.localhost blob: https://canari.emse.fr wss://canari.emse.fr https://canari-emse.fr wss://canari-emse.fr https://www.canari-emse.fr wss://www.canari-emse.fr https://dev.canari-emse.fr wss://dev.canari-emse.fr http://localhost:1420 ws://localhost:1420 http://127.0.0.1:1420 ws://127.0.0.1:1420",
        "img-src": "'self' data: blob: https: http://localhost:1420 http://127.0.0.1:1420",
        "font-src": "'self' data: http://localhost:1420 http://127.0.0.1:1420",
        "worker-src": "'self' blob: http://localhost:1420 http://127.0.0.1:1420",
        "media-src": "'self' blob: https://canari.emse.fr https://canari-emse.fr https://www.canari-emse.fr https://dev.canari-emse.fr",
        "frame-src": "'self'",
        "form-action": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "capabilities": [
        "default",
        "ios-system-components"
      ]
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "fr.emse.canari"
          ],
          "host": "callback"
        },
        {
          "scheme": [
            "fr.emse.canari"
          ],
          "host": "signed-out"
        },
        {
          "scheme": [
            "fr.emse.canari"
          ],
          "host": "payment"
        },
        {
          "scheme": [
            "fr.emse.canari"
          ],
          "host": "chat"
        },
        {
          "scheme": [
            "fr.emse.canari"
          ],
          "host": "post"
        },
        {
          "scheme": [
            "fr.emse.canari"
          ],
          "host": "form"
        },
        {
          "scheme": [
            "fr.emse.canari"
          ],
          "host": "posts"
        },
        {
          "scheme": [
            "fr.emse.canari"
          ],
          "host": "calendar"
        },
        {
          "scheme": [
            "fr.emse.canari"
          ],
          "host": "admin-agenda"
        },
        {
          "scheme": [
            "fr.emse.canari"
          ],
          "host": "proposals"
        },
        {
          "scheme": [
            "fr.emse.canari"
          ],
          "host": "live"
        },
        {
          "scheme": [
            "fr.emse.canari"
          ],
          "host": "republication-requests"
        },
        {
          "scheme": [
            "fr.emse.canari"
          ],
          "host": "notifications"
        },
        {
          "scheme": [
            "fr.emse.canari"
          ],
          "host": "form-responses"
        },
        {
          "scheme": [
            "https"
          ],
          "host": "canari-emse.fr",
          "appLink": true,
          "path": [
            "/chat",
            "/communities",
            "/notifications",
            "/calendar",
            "/shop",
            "/bookings",
            "/"
          ],
          "pathPrefix": [
            "/posts/",
            "/forms/",
            "/associations/",
            "/profile/",
            "/chat/",
            "/communities/",
            "/c/join/",
            "/g/join/",
            "/notifications/",
            "/calendar/",
            "/shop/",
            "/bookings/"
          ]
        },
        {
          "scheme": [
            "https"
          ],
          "host": "canari.emse.fr",
          "appLink": true,
          "path": [
            "/chat",
            "/communities",
            "/notifications",
            "/calendar",
            "/shop",
            "/bookings",
            "/"
          ],
          "pathPrefix": [
            "/posts/",
            "/forms/",
            "/associations/",
            "/profile/",
            "/chat/",
            "/communities/",
            "/c/join/",
            "/g/join/",
            "/notifications/",
            "/calendar/",
            "/shop/",
            "/bookings/"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "developmentTeam": "4CLNB8SR6L",
      "minimumSystemVersion": "16.0"
    },
    "android": {
      "versionCode": 100400102
    }
  }
}
