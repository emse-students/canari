<?xml version="1.0" encoding="utf-8"?>
<!--
  /!\  THIS MANIFEST IS CUSTOM - DO NOT LET `tauri android init` OVERWRITE IT.
  `tauri android build`/`dev` only touch the deep-link section (AUTO-GENERATED
  markers). But `tauri android init` / `tauri migrate` / a major Tauri upgrade
  regenerate gen/android from the template and ERASE everything below.
  If that happens (see regression 53e659a0), these MUST be restored:
    - <application android:name=".CanariApplication">  (channel init, push secret)
    - <service .CanariFirebaseMessagingService> + MESSAGING_EVENT intent-filter
      (WITHOUT it, Firebase never calls onMessageReceived -> no notification at all
      once the app is killed)
    - push permissions: POST_NOTIFICATIONS, WAKE_LOCK, c2dm RECEIVE, RECEIVE_BOOT_COMPLETED
    - <receiver .CanariBootReceiver> (BOOT_COMPLETED/MY_PACKAGE_REPLACED, WP-XP-4)
    - <receiver .CanariNotificationActionReceiver> (quick actions, WP-XP-1)
    - the AD_ID removal, networkSecurityConfig, allowBackup=false AND
      dataExtractionRules=@xml/data_extraction_rules, both in tools:replace. BOTH are
      needed: allowBackup is deprecated from Android 12 and, on several manufacturers,
      stops cloud backup WITHOUT stopping device-to-device transfer, which defaults to
      copying everything when no <device-transfer> rule is declared.
  DO NOT restore android:debuggable (the ${debuggable} placeholder is not defined in
  build.gradle.kts -> merge failure). fullBackupContent stays out; dataExtractionRules
  is IN, and the merge conflict it used to cause is what tools:replace answers.
    - FCM meta-data default_notification_icon / _channel_id (= CHANNEL_MESSAGES in Kotlin)
  CI guardrail: src/lib/mobile/androidFcmManifest.test.ts fails if any of these is dropped.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Removes the AD_ID permission Firebase Analytics adds automatically -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- READ_EXTERNAL_STORAGE has had no effect since API 33: capped at API 28-32. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- WRITE_EXTERNAL_STORAGE removed: no effect since API 29 (scoped storage is mandatory). -->
    <!-- Media access on Android 13+ (API 33+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Push notifications -->
    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WP-XP-4: push-token re-registration + outbox drain at boot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- WP-XP-5 declared USE_FULL_SCREEN_INTENT here for the locked-screen CallStyle ring. It is
         GONE while calls are held off (frontend/src/lib/features.ts, CALLS_ENABLED): Play grants
         that permission only to apps whose core function is calling or alarms, and declaring it for
         a surface no user can reach is the Play analogue of the `voip` background mode App Review
         refused on 2026-08-31. The tag is deleted rather than commented out on purpose - a commented
         tag still satisfies a `toContain` guardrail, which is how a removal turns into a false
         green. Restore it in the same commit that flips CALLS_ENABLED. -->
    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:name=".CanariApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.mines_app"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:replace="android:allowBackup,android:dataExtractionRules">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
            <intent-filter >
                <action android:name="android.intent.action.VIEW" />
                <!-- ChromeOS ARC++ uses a different action for deep links -->
                <action android:name="org.chromium.arc.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fr.emse.canari" />
                <data android:host="callback" />
                
                
                
                
            </intent-filter>
            <intent-filter >
                <action android:name="android.intent.action.VIEW" />
                <!-- ChromeOS ARC++ uses a different action for deep links -->
                <action android:name="org.chromium.arc.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fr.emse.canari" />
                <data android:host="stripe" />
                
                
                
                
            </intent-filter>
            <intent-filter >
                <action android:name="android.intent.action.VIEW" />
                <!-- ChromeOS ARC++ uses a different action for deep links -->
                <action android:name="org.chromium.arc.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fr.emse.canari" />
                <data android:host="chat" />
                
                
                
                
            </intent-filter>
            <intent-filter >
                <action android:name="android.intent.action.VIEW" />
                <!-- ChromeOS ARC++ uses a different action for deep links -->
                <action android:name="org.chromium.arc.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fr.emse.canari" />
                <data android:host="post" />
                
                
                
                
            </intent-filter>
            <intent-filter >
                <action android:name="android.intent.action.VIEW" />
                <!-- ChromeOS ARC++ uses a different action for deep links -->
                <action android:name="org.chromium.arc.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fr.emse.canari" />
                <data android:host="form" />
                
                
                
                
            </intent-filter>
            <intent-filter android:autoVerify="true" >
                <action android:name="android.intent.action.VIEW" />
                <!-- ChromeOS ARC++ uses a different action for deep links -->
                <action android:name="org.chromium.arc.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="canari-emse.fr" />
                <data android:path="/chat" />
                <data android:path="/communities" />
                <data android:path="/notifications" />
                <data android:path="/calendar" />
                <data android:path="/shop" />
                <data android:path="/" />
                <data android:pathPrefix="/posts/" />
                <data android:pathPrefix="/forms/" />
                <data android:pathPrefix="/associations/" />
                <data android:pathPrefix="/profile/" />
                <data android:pathPrefix="/chat/" />
                <data android:pathPrefix="/communities/" />
                <data android:pathPrefix="/c/join/" />
                <data android:pathPrefix="/g/join/" />
                <data android:pathPrefix="/notifications/" />
                <data android:pathPrefix="/calendar/" />
                <data android:pathPrefix="/shop/" />
                
                
                
                
            </intent-filter>
            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>

        <!-- FCM message reception (push). Without this <service> + intent-filter,
             Firebase never calls onMessageReceived -> no notification once the app is killed. -->
        <service
            android:name=".CanariFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Default icon and channel for FCM notifications -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="canari_messages" />

        <!-- Notification quick actions (WP-XP-1): inline reply / mark as read from the shade. -->
        <receiver
            android:name=".CanariNotificationActionReceiver"
            android:exported="false" />

        <!-- Boot/relaunch re-registration (WP-XP-4): re-reads the FCM token and drains the outbox
             at boot / after an app update. exported=false is enough: these are protected
             broadcasts, emitted by the system only (the same pattern as WorkManager's
             RescheduleReceiver). -->
        <receiver
            android:name=".CanariBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
