<?xml version="1.0" encoding="utf-8"?>
<!--
  THE ONGOING-CALL SERVICE (WP-C-BG-A), MERGED ONLY INTO A BUILD THAT PLACES CALLS.

  `app/build.gradle.kts` adds this file to the debug and release build types when the build's
  `VITE_DEPLOY_ENVIRONMENT` is `development` - the same fact that turns `CALLS_ENABLED` on in the
  page (`frontend/src/lib/features.ts`): every pre-release, and a local build that sets it. A store
  build (stable) merges none of it, because a foreground-service type is a Play Console declaration
  and declaring one for a surface no user can reach is the Play twin of the `voip` mode App Review
  refused (calls.md, the switches table). It is an IN-APP call's need, so it follows CALLS_COMPILED,
  not the native ring's CALLS_NATIVE_RING_COMPILED. The day CALLS_COMPILED flips, these entries move into
  `src/main/AndroidManifest.xml` in the same commit: `androidCallServiceManifest.test.ts` asserts the
  main manifest declares them exactly when CALLS_COMPILED is true.

  Type `microphone`, not `phoneCall`: see CallForegroundService.kt for why.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application>
        <service
            android:name="fr.emse.canari.CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
