/* Notification text composed by the Notification Service Extension - French, the default.
   The extension is a separate bundle from the app, so it cannot read canari_iOS/*.lproj; this is
   a deliberate copy of the keys the NSE uses. Keep both sides in sync.

   Read through the .lproj bundle named by `locale` in push_context.json - the language chosen in
   the app, NOT the device language. See NotificationService.localized(). */
"notif.reaction.body" = "a réagi %@ à votre message";
"notif.message.from" = "Nouveau message de %@";
"notif.message.encrypted" = "Vous avez reçu un message chiffré";
"notif.channel.message" = "Nouveau message dans #%@";
"notif.channel.unnamed" = "Salon";
/* The legacy MLS call invite: only pre-WP-XP-5 callers send it as an alert push, and this process
   is the one that renders it when the app is killed. The emoji stays in the code - it is not a
   translation. */
"notif.call.incoming" = "Appel entrant";
"notif.call.incoming_video" = "Appel vidéo entrant";

/* Server-composed pushes, moved here 2026-08-19: social-service sends a `contentKey` and at most a
   name and one fragment, and this process writes the sentence in the language chosen in the app. */
"notif.social.mention.title" = "%@ vous a mentionné";
"notif.social.mention.body" = "Vous avez été mentionné dans un commentaire";
"notif.social.reply.title" = "%@ a répondu";
"notif.social.reply.body" = "Nouvelle réponse";
"notif.social.comment.title" = "%@ a commenté";
"notif.social.comment.body" = "Nouveau commentaire";
"notif.social.reaction.title" = "Nouvelle réaction";
"notif.social.reaction.body" = "%1$@ a réagi %2$@ à votre publication";
"notif.form.opening_soon.title" = "Formulaire bientôt ouvert";
"notif.form.opening_soon.body" = "Un formulaire que vous suivez ouvre dans 5 minutes !";
"notif.form.open.title" = "Formulaire ouvert !";
"notif.form.open.body" = "Le formulaire est disponible - dépêchez-vous, les places sont limitées !";

/* The agenda's five, added 2026-09-09 with the notifications themselves. */
"notif.event.proposed.title" = "Événement à valider";
"notif.event.proposed.body" = "%1$@ propose « %2$@ »";
"notif.event.validated.title" = "Événement validé";
"notif.event.validated.body" = "« %1$@ » a été validé par le BDE";
"notif.event.rejected.title" = "Événement refusé";
"notif.event.rejected.body" = "« %1$@ » a été refusé par le BDE";
"notif.event.updated.title" = "Événement modifié";
"notif.event.updated.body" = "« %1$@ » a été modifié par le BDE";
"notif.event.deleted.title" = "Événement supprimé";
"notif.event.deleted.body" = "« %1$@ » a été supprimé par le BDE";
