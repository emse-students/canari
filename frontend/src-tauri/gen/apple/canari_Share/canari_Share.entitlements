<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The ONE entitlement the Share Extension needs: the container it shares with the app, where it
	     leaves the copies and pending_share.json for the app to carry over. No keychain group - it
	     reads no secret. Must match the App Group on the fr.emse.canari.share App ID and the
	     "CanariShare" profiles. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.fr.emse.canari</string>
	</array>
</dict>
</plist>
