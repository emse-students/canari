    <resources>
        <image name="LaunchLogo" width="160" height="160"/>
        <!-- AppBackground (Assets.xcassets) mirrors Android's app_background - #FFF9FBFF light /
             #FF070B12 dark (colors.xml / values-night/colors.xml) - so the launch screen shows
             the product's colour instead of Apple's systemBackgroundColor
             (docs/wiki/frontend/android-ios-parity.md#1.3). -->
        <namedColor name="AppBackground">
            <color red="0.976" green="0.984" blue="1.000" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
