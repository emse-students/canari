<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<!-- WP-XP-5: lets @-mention and call notifications use interruptionLevel=timeSensitive
	     (Focus breakthrough). Requires the "Time Sensitive Notifications" capability enabled on
	     the fr.emse.canari App ID + a regenerated "Canari" provisioning profile, or codesign
	     fails ("profile doesn't include the ... entitlement"). -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- MUST mirror MOBILE_APP_LINK_HOSTS in src/lib/mobile/appSiteAssociation.ts, which is the
	     canonical host list for BOTH platforms; appSiteAssociation.test.ts fails on drift.
	     `www` is deliberately absent: it 301-redirects to the apex (including
	     /.well-known/apple-app-site-association, measured on prod 2026-08-07) and Apple's
	     association fetch does not follow redirects, so claiming it can never validate. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:canari-emse.fr</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.fr.emse.canari</string>
	</array>
	<!-- WP-SEC-1: lets the app write a background-accessible (AfterFirstUnlock)
	     device key into the shared keychain for the NSE to read. Requires Keychain
	     Sharing enabled on the fr.emse.canari App ID + regenerated provisioning
	     profiles for both "Canari" and "CanariNotifications" (team 4CLNB8SR6L),
	     or codesign fails ("profile doesn't include the ... entitlement"). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)group.fr.emse.canari</string>
	</array>
</dict>
</plist>
