{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "sourceMap": true,
    "strict": true
  },
  // `$app/tsconfig` carries no `include`/`exclude`. The two generated JS bundles are imported (so
  // typed through their `.d.ts`) but never checked as source.
  "include": ["src", "*.js", "*.ts"],
  "exclude": ["src/lib/proto/canari.js", "src/lib/wasm/**/*.js"]
}
