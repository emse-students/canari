{
  "name": "canari",
  "version": "1.5.0-alpha.1",
  "private": true,
  "description": "",
  "license": "SEE LICENSE IN ../LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && bun ./scripts/check-bundle-consistency.mjs && bun ./scripts/check-platform-service.mjs && bun ./scripts/check-emoji-coverage.mjs && bun ./scripts/check-built-csp.mjs",
    "preview": "vite preview",
    "test": "bun run paraglide:compile && bun run paraglide:compile:test && vitest run",
    "test:watch": "bun run paraglide:compile:test && vitest",
    "test:coverage": "bun run paraglide:compile:test && vitest run --coverage",
    "bench:media-crypto": "bun run scripts/bench-image-encryption.ts",
    "prepare": "bun ./scripts/install-husky.js && bun run paraglide:compile && bun run paraglide:compile:test",
    "wasm:build": "wasm-pack build mls-wasm --target web --out-dir ../src/lib/wasm",
    "generate": "bun run wasm:build && bun run proto:gen",
    "proto:gen": "pbjs -t static-module -w es6 --es6 --no-service --force-number -o src/lib/proto/canari.js ../libs/proto/canari.proto && pbts -o src/lib/proto/canari.d.ts src/lib/proto/canari.js && bun ./scripts/fix-protobuf-c-alias.mjs",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "paraglide:compile:test": "paraglide-js compile --project ./project.inlang --outdir ./.paraglide-test --output-structure locale-modules --silent",
    "check": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:strict": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold warning",
    "check:watch": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint -c .oxlintrc.json . && sh ../scripts/run-oxvelte.sh lint --config oxvelte.config.json src",
    "lint:fix": "oxlint -c .oxlintrc.json --fix . && sh ../scripts/run-oxvelte.sh lint --config oxvelte.config.json --fix src",
    "format": "oxfmt -c ../oxfmt.json --write .",
    "format:check": "oxfmt -c ../oxfmt.json --check .",
    "sync": "svelte-kit sync",
    "tauri": "tauri",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build"
  },
  "dependencies": {
    "@expo-google-fonts/chewy": "^0.4.0",
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/leckerli-one": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/chewy": "^5.3.0",
    "@fontsource/leckerli-one": "^5.3.0",
    "@humanspeak/svelte-markdown": "^2.1.3",
    "@lucide/svelte": "^1.61.0",
    "@sosweetham/tauri-plugin-system-components-api": "0.1.8",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-biometric": "^2.5.0",
    "@tauri-apps/plugin-deep-link": "^2.6.2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@tauri-apps/plugin-websocket": "^2.5.0",
    "@zumer/snapdom": "^3.3.6",
    "highlight.js": "^11.12.0",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "mediabunny": "^1.61.4",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "svelte-dnd-action": "^0.9.80",
    "thumbhash": "^0.1.1"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.29.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.0.5",
    "emoji-picker-element-data": "1.8.0",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "parse5": "8.0.1",
    "protobufjs": "^8.8.1",
    "protobufjs-cli": "^2.7.1",
    "sharp": "^0.35.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "cookie": "^0.7.0",
    "dompurify": "^3.4.16",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.10"
  },
  "patchedDependencies": {
    "svelte-dnd-action@0.9.80": "patches/svelte-dnd-action@0.9.80.patch",
    "mediabunny@1.61.4": "patches/mediabunny@1.61.4.patch"
  }
}
