{
  "name": "canari",
  "version": "0.14.4",
  "private": true,
  "description": "",
  "license": "SEE LICENSE IN ../LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node ./scripts/check-bundle-consistency.mjs",
    "preview": "vite preview",
    "test": "npm run paraglide:compile && vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "bench:media-crypto": "bun run scripts/bench-image-encryption.ts",
    "prepare": "node ./scripts/install-husky.js && npm run paraglide:compile",
    "wasm:build": "wasm-pack build mls-wasm --target web --out-dir ../src/lib/wasm",
    "generate": "npm run wasm:build && npm run proto:gen",
    "proto:gen": "pbjs -t static-module -w es6 --es6 --no-service --force-number -o src/lib/proto/canari.js ../libs/proto/canari.proto && pbts -o src/lib/proto/canari.d.ts src/lib/proto/canari.js && node ./scripts/fix-protobuf-c-alias.mjs",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "check": "npm run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:strict": "npm run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold warning",
    "check:watch": "npm run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint -c .oxlintrc.json src && bash ../scripts/run-oxvelte.sh lint --config oxvelte.config.json src",
    "lint:fix": "oxlint -c .oxlintrc.json --fix src && bash ../scripts/run-oxvelte.sh lint --config oxvelte.config.json --fix src",
    "format": "oxfmt -c ../oxfmt.json --write .",
    "format:check": "oxfmt -c ../oxfmt.json --check .",
    "sync": "svelte-kit sync",
    "tauri": "tauri",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build"
  },
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@humanspeak/svelte-markdown": "^1.8.8",
    "@lucide/svelte": "^1.34.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-biometric": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-log": "2.8.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-websocket": "^2.4.2",
    "@zumer/snapdom": "^2.24.10",
    "emoji-picker-element": "^1.29.1",
    "highlight.js": "^11.12.0",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "svelte-dnd-action": "^0.9.79"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.24.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^25.9.5",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.11",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.6",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.80.0",
    "protobufjs": "^8.7.2",
    "protobufjs-cli": "^2.6.2",
    "sharp": "^0.35.4",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "cookie": "^0.7.0",
    "dompurify": "^3.4.14",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.10"
  }
}
