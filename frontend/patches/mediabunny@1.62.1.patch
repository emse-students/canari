+/**
+ * [canari patch, https://github.com/Vanilagy/mediabunny/issues/559] Some `VideoEncoder`s (Firefox on
+ * Windows, through Media Foundation) emit an AVCDecoderConfigurationRecord whose SPS and PPS each
+ * carry their first byte twice, with the reserved bits zeroed - while the key packets carry the
+ * correct parameter sets in-band. Chrome cannot decode such a file. When a key packet's in-band SPS
+ * or PPS differ from the record's, the record is rebuilt from the in-band ones, which ARE the
+ * bitstream. Returns the rebuilt record, or null when the record already matches (or the packet
+ * carries no parameter sets).
+ */
+export const rebuildAvcDescriptionFromInBand = (packetData, description) => {
+    const bytes = toUint8Array(description);
+    if (bytes.length < 5) {
+        return null;
+    }
+    const lengthSize = (bytes[4] & 0b11) + 1;
+    const sps = [];
+    const pps = [];
+    const spsExt = [];
+    for (const loc of iterateNalUnitsInLengthPrefixed(packetData, lengthSize)) {
+        if (loc.offset + loc.length > packetData.length) {
+            return null;
+        }
+        const nalUnit = packetData.subarray(loc.offset, loc.offset + loc.length);
+        const type = extractNalUnitTypeForAvc(nalUnit[0]);
+        if (type === AvcNalUnitType.SPS) {
+            sps.push(nalUnit);
+        }
+        else if (type === AvcNalUnitType.PPS) {
+            pps.push(nalUnit);
+        }
+        else if (type === AvcNalUnitType.SPS_EXT) {
+            spsExt.push(nalUnit);
+        }
+    }
+    if (sps.length === 0 || pps.length === 0) {
+        return null;
+    }
+    const sameUnits = (a, b) => a.length === b.length
+        && a.every((unit, i) => unit.length === b[i].length && unit.every((byte, j) => byte === b[i][j]));
+    const record = deserializeAvcDecoderConfigurationRecord(bytes);
+    if (record && sameUnits(record.sequenceParameterSets, sps) && sameUnits(record.pictureParameterSets, pps)) {
+        return null;
+    }
+    const annexB = new Uint8Array([...sps, ...spsExt, ...pps].reduce((n, unit) => n + 4 + unit.length, 0));
+    let offset = 0;
+    for (const unit of [...sps, ...spsExt, ...pps]) {
+        annexB.set([0, 0, 0, 1], offset);
+        annexB.set(unit, offset + 4);
+        offset += 4 + unit.length;
+    }
+    const rebuilt = extractAvcDecoderConfigurationRecord(annexB);
+    if (!rebuilt) {
+        return null;
+    }
+    rebuilt.lengthSizeMinusOne = lengthSize - 1;
+    return serializeAvcDecoderConfigurationRecord(rebuilt);
+};
