# ──────────────────────────────────────────────────────────────────────────────
# Variables de la stack Authentik (projet "miconnect")
# Ecrit A LA MAIN dans le .env de la stack sur l hote, SAUF la ligne AUTHENTIK_TAG : celle-la est
# ecrite par la release (deploy-stack.sh), et le compte du runner doit pouvoir lire et ecrire ce
# fichier (infrastructure/MIGRATION.md, MiConnect)
# ──────────────────────────────────────────────────────────────────────────────

# Mot de passe PostgreSQL Authentik. Secret GitHub: MICONNECT_PG_PASS
# Generer avec : openssl rand -hex 24
PG_PASS=

# Cle secrete Authentik (signatures de session/tokens). Secret GitHub: MICONNECT_AUTHENTIK_SECRET_KEY
# Generer avec : openssl rand -base64 60
AUTHENTIK_SECRET_KEY=

# Non-secrets (valeurs par defaut du compose, surchargeables si besoin)
# PG_DB=authentik
# PG_USER=authentik
# Ecrite par la release, jamais a la main : la version que compose.yml epingle, pour la copie du
# compose de l hote qui lit encore `${AUTHENTIK_TAG}`. Pas d AUTHENTIK_IMAGE : la release refuse un
# .env qui en impose une autre.
# AUTHENTIK_TAG=2026.8.5
# Adresse de publication du serveur, cote HOTE. Une seule, et c'est une ADRESSE : elle porte
# l'hote autant que le port, pour qu'un demenagement puisse la lier a la loopback sans toucher au
# compose. Sur une machine partagee, c'est 127.0.0.1:9000 et jamais 9000 tout court.
# AUTHENTIK_PUBLISH=9000

# Cle de signature des URL d avatar MiGallery (mapping `avatar`). MEME valeur que le secret
# GitHub AVATAR_SIGNING_KEY du depot MiGallery. Generer avec : openssl rand -base64 48
MIGALLERY_AVATAR_SIGNING_KEY=

# Secret du client OIDC `miconnect` que la DSI a cree sur le CAS de l ecole. Lu par le blueprint
# 30-sources.yaml. Il n est PAS genere ici : il vient de la DSI, et une instance de dev a le sien.
MICONNECT_CAS_CONSUMER_SECRET=
MICONNECT_EDITOR_TOKEN=
