# ──────────────────────────────────────────────────────────────────────────────
# Production Environment Variables
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
DOMAIN=canari-emse.fr
# chat-gateway CORS (WebSocket /api/ws, /api/presence). Use * for dev, or a comma-separated
# list so local Vite matches the browser Origin, e.g.:
#   ALLOW_ORIGIN=https://canari-emse.fr,http://localhost:1420
ALLOW_ORIGIN=https://canari-emse.fr

# Public SPA origin - sans slash final. Utilisée par tous les Nest (CORS acceptés,
# dont chat-delivery pin-check si le client les appelle hors même origine) et cookies auth.
# Le workflow CD définit automatiquement FRONTEND_URL dans infrastructure/.env
# depuis le secret GitHub BASE_URL (= URL publique du site).
FRONTEND_URL=https://canari-emse.fr

# Contrôle général NODE.js (production par défaut via compose).
# NODE_ENV=production

# ── Docker Registry ───────────────────────────────────────────────────────────
REGISTRY=ghcr.io
IMAGE_PREFIX=emse-students/canari
TAG=latest

# ── Security ──────────────────────────────────────────────────────────────────
# Utilisé par : chat-gateway (validation des tokens WebSocket)
# En prod, doit correspondre au GitHub Secret JWT_SECRET (injecté au build CI)
# Générer avec : openssl rand -hex 32
JWT_SECRET=your-secret-jwt-key-here-change-me

# Secret partagé entre social-service et chat-delivery-service pour les appels push internes.
# Doit correspondre dans les deux services. Générer avec : openssl rand -hex 32
INTERNAL_SECRET=your-internal-secret-here-change-me

# Compte de vérification utilisé par les relecteurs Google/Apple lors de la validation
# de l'app. Il est masqué des utilisateurs non-admin (recherche, annuaire, feed de posts)
# et ne peut lui-même trouver que les admins. Vide = aucune restriction. C'est un id
# utilisateur (hex), pas un secret sensible ; peut être surchargé par le secret GitHub.
SERVICE_ACCOUNT_USER_ID=9855dfafdadcbdcfc69bcd1fffc447f9b53536428ef767fd164297ffe49cc4cf

# Clé API de l'endpoint profil public /api/external/* (core-service), consommée
# par des apps externes de confiance (Sky). Doit être identique à CANARI_API_KEY
# côté Sky. Vide = l'endpoint rejette toutes les requêtes. Générer : openssl rand -hex 32
EXTERNAL_API_KEY=

# Clé API de l'endpoint /api/public/cotisant-status (social-service), consommée par
# Cercle pour verifier le statut cotisant d'un utilisateur avant de facturer un
# rechargement de solde. Vide = l'endpoint rejette toutes les requêtes.
# Générer : openssl rand -hex 32
CERCLE_API_KEY=

# Clé pour que core-service appelle l'API publique de Sky (arbre de parrainage
# affiché sur les profils). Doit être identique à SKY_API_KEY côté Sky.
# Vide = l'arbre n'est pas affiché. Générer : openssl rand -hex 32
SKY_API_KEY=
# URL publique de l'app Sky (défaut https://sky.mitv.fr).
SKY_API_URL=https://sky.mitv.fr

# Secret partagé entre TOUS les services backend pour authentifier les headers nginx inter-service.
# Utilisé par le guard HMAC X-Internal-Token (core, chat-delivery, social).
# REQUIS en production. Générer avec : openssl rand -hex 32
INTERNAL_SHARED_SECRET=your-internal-shared-secret-here-change-me

# Secret partagé entre chat-delivery-service et call-service pour les tokens d'accès aux rooms WebRTC.
# Empêche un utilisateur de rejoindre la room d'un autre. Générer avec : openssl rand -hex 32
CALL_ROOM_SECRET=your-call-room-secret-here-change-me

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=auth_db

# ── Logging ───────────────────────────────────────────────────────────────────
RUST_LOG=chat_gateway=info,tower_http=info
NODE_ENV=production

# ── Ports ──────────────────────────────────────────────────────────────────────
# Port hôte du frontend Docker (cloudflared peut pointer vers localhost:8080)
FRONTEND_HOST_PORT=8080

# Ports internes des services backend
GATEWAY_PORT=3000
DELIVERY_PORT=3001

# ── Media Service / Garage (S3-compatible object storage, formerly MinIO) ──────
# Garage has no "root user" - GARAGE_DEFAULT_ACCESS_KEY/SECRET_KEY below are what it
# provisions on first boot (--default-bucket), and they double as the app's own S3
# credentials. Pick any strings, exactly like the old MinIO root user/password.
# Générer avec : openssl rand -hex 32
GARAGE_RPC_SECRET=
# Générer avec : openssl rand -hex 32
GARAGE_ADMIN_TOKEN=
# Ports hôte pour éviter les conflits locaux (conteneur reste sur 3900/3903)
MINIO_API_HOST_PORT=19000
GARAGE_ADMIN_HOST_PORT=19011
MINIO_ENDPOINT=garage
MINIO_PORT=3900
MINIO_USE_SSL=false
# Doit correspondre à s3_region dans infrastructure/garage/garage.toml
MINIO_REGION=garage
# Générer avec : openssl rand -hex 16 (n'importe quelle chaîne convient à Garage)
MINIO_ACCESS_KEY=
# Générer avec : openssl rand -base64 24
MINIO_SECRET_KEY=
MINIO_BUCKET=canari-media
MEDIA_MAX_SIZE_MB=50

# ── User Avatar Service ──────────────────────────────────────────────────────
# API externe pour la gestion des photos de profil (obligatoire)
MIGALLERY_API_URL=https://gallery.mitv.fr
MIGALLERY_API_KEY=

# ── Link Safety (chat-delivery-service, WP-SAFELINK-1, optionnel) ────────────
# Google Safe Browsing API key (GitHub secret GOOGLE_SAFE_BROWSING_API_KEY). Vérifie les liens
# partagés en message/post avant redirection. Optionnel et fail-open : une clé absente ou une
# panne de l'API ne bloque aucun lien, elle désactive seulement l'avertissement.
GOOGLE_SAFE_BROWSING_API_KEY=

# ── Authentik OIDC ───────────────────────────────────────────────────────────
# URL de base de l'instance Authentik (sans slash final)
AUTHENTIK_BASE_URL=https://auth.example.com
# Client ID et Secret du Provider OAuth2/OIDC Authentik (type Confidential)
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# ── Push Notifications Android (FCM) ────────────────────────────────────────
# JSON du compte de service Firebase Admin SDK (obligatoire pour le push Android).
# Générer depuis : console.firebase.google.com → Paramètres projet → Comptes de service → Générer une nouvelle clé privée
# Coller le contenu JSON sur une seule ligne (ou utiliser un secret dans votre CI/CD).
# Sans cette variable, toutes les notifications push Android sont désactivées silencieusement.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── APNs VoIP (iOS CallKit rings, WP-XP-5, optionnel) ─────────────────────────
# Clé d'authentification APNs (.p8) : developer.apple.com → Keys → APNs.
# Contenu PEM encodé en base64 sur une seule ligne (le service accepte aussi le PEM brut).
# Sans ces variables, iOS reçoit une bannière FCM au lieu d'une sonnerie CallKit.
APNS_VOIP_KEY_P8=
APNS_VOIP_KEY_ID=
APNS_VOIP_TEAM_ID=
# Topic VoIP (défaut : fr.emse.canari.voip) et sandbox APNs (builds dev uniquement)
APNS_VOIP_TOPIC=
APNS_VOIP_SANDBOX=

# ── WebRTC / Cloudflare Calls TURN (required for voice/video calls) ───────────
# API token (GitHub secret CLOUDFLARE_CALLS_API_TOKEN) - never expose to the browser.
# GET /api/calls/ice-servers returns 503 if either value below is missing.
CLOUDFLARE_CALLS_API_TOKEN=
# TURN key ID from Cloudflare Dashboard → Realtime → TURN
CLOUDFLARE_TURN_KEY_ID=
# Credential TTL in seconds (default 7200 = 2 hours)
CLOUDFLARE_TURN_TTL_SECONDS=7200
# Optional: TURN for call-service SFU container only (not used by ice-servers API)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Stripe (core-service) ─────────────────────────────────────────────────────
# Clé secrète API Stripe (sk_live_… ou sk_test_…)
STRIPE_SECRET_KEY=
# Signing secret du endpoint webhook (whsec_…) - Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=

# ── Lydia (core-service, WP-LYDIA-1) ──────────────────────────────────────────
# Quel fournisseur est réellement actif (stripe/lydia) est un réglage admin
# (platform_config.paymentProvider, /admin/platform) - pas cette variable. Ces
# identifiants sont juste les credentials Lydia, lus par le provider quand il est actif.
# homologation (tests) ou production
LYDIA_ENV=homologation
# Token public du provider Canari (business/create, business/addcashier)
LYDIA_PROVIDER_TOKEN=
# Token privé du provider Canari - sert uniquement à signer, jamais envoyé à Lydia
LYDIA_PROVIDER_PRIVATE_TOKEN=

# ── Dev Routes ───────────────────────────────────────────────────────────────
# Active des routes de développement sensibles (ex: dev-login).
# Laisser à false sauf besoin explicite en environnement local contrôlé.
ENABLE_DEV_ROUTES=false
