# -- Build stage ---------------------------------------------------------------
# bun installs, compiles and serves. The tag is literal rather than read from
# `.bun-version` because a Dockerfile cannot read a file to pick its base image -
# and a literal is what Dependabot's docker ecosystem follows, so this line stays
# current on its own. A BUN BUMP'S COST IS MEASURED, NOT ASSUMED: this line used to
# promise that a bun >= 1.4.0 "reads an existing v1 lockfile unchanged", and 1.4.0
# falsified it - it writes v3, and it REFUSES a v1 lock whose `overrides` are nested,
# because 1.3.14 had saved only the flat ones. That skipped a deploy. Regenerate every
# lock with the tag ON THIS LINE before bumping it; CI's frozen install is the proof.
#
# A `libs/shared-ts` build stage used to sit here, installing and compiling a
# package whose output was then copied nowhere. Both the stage and the package
# are gone - nothing in any service imported it. `--install-links` went too.
FROM oven/bun:1.4.0-alpine AS builder

WORKDIR /app

# Manifest and lockfile first, so a source-only change reuses the install layer.
COPY apps/chat-delivery-service/package.json apps/chat-delivery-service/bun.lock ./apps/chat-delivery-service/
RUN cd apps/chat-delivery-service && bun install --frozen-lockfile

COPY apps/chat-delivery-service ./apps/chat-delivery-service
RUN cd apps/chat-delivery-service && bunx tsc -p tsconfig.build.json

# -- Runtime stage -------------------------------------------------------------
FROM oven/bun:1.4.0-alpine

WORKDIR /app

COPY --from=builder /app/apps/chat-delivery-service/dist ./dist
COPY --from=builder /app/apps/chat-delivery-service/node_modules ./node_modules
COPY --from=builder /app/apps/chat-delivery-service/package.json ./

EXPOSE 3010

# The image has no node, so the check runs under bun - the same runtime that serves.
HEALTHCHECK --interval=30s --timeout=5s --start-period=50s --retries=3   CMD bun -e "fetch('http://127.0.0.1:'+(process.env.PORT||3010)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["bun", "dist/main.js"]
