# ── Runtime: Nginx, point d'entree public ────────────────────────────────────
# Le build Svelte est effectué en amont par le CI (job build-frontend) avec les
# variables VITE_* publiques (URLs des services) et BUILD_WEB=1, qui selectionne
# adapter-node. Aucun secret n'est embarque dans le bundle. L'artifact compilé est téléchargé dans frontend/build/ avant que
# cette image soit construite.
# NE PAS rebuilder ici : les variables VITE_* du build ne seraient pas disponibles dans ce contexte.
# Et `--build` sur ce service NE RECONSTRUIT RIEN : cette image n'est qu'une COPY
# de `frontend/build`, donc Docker rend l'image de la derniere fois que quelqu'un
# a produit l'artefact, sans rien dire. `make local-frontend` est le seul chemin
# qui rafraichit les deux images ; le detail et la mesure sont dans
# Dockerfile.frontend-ssr, qui porte exactement le meme piege.
#
# adapter-node produit build/client (les assets), build/prerendered (robots.txt,
# sitemap.xml, .well-known/) et un serveur Node. Nginx sert les deux premiers
# exactement comme avant - memes en-tetes de cache, meme correctif MIME .mjs -
# et ne delegue au conteneur frontend-ssr que les navigations HTML, les seules a
# avoir besoin d'un <head> calcule (cf. frontend/src/hooks.server.ts).
# Dev branch build trigger
FROM nginx:stable-alpine

COPY frontend/build/client /usr/share/nginx/html
COPY frontend/build/prerendered /usr/share/nginx/html

# adapter-static used to overwrite the base image's own index.html; adapter-node
# emits none, so the nginx welcome page survived the COPY and the index module
# served it on "/". Delete it (and its 50x companion) so nothing can ever fall
# back to it - the root is routed explicitly to @ssr below.
RUN rm -f /usr/share/nginx/html/index.html /usr/share/nginx/html/50x.html

# The Content-Security-Policy, stated ONCE and included by every block that sets
# security headers. nginx's add_header REPLACES the inherited set instead of adding
# to it, so a block that sets any header of its own loses the policy unless it
# restates it - which is why every block below that sets one restates all three.
# Verbatim copies is how a policy drifts: two get a new host, the third silently
# keeps blocking it, so the CSP itself is included rather than retyped.
#
# THE RULE WAS STATED HERE AND NOT APPLIED, which is why it is now a gate
# (.github/scripts/tests/static-headers.test.mjs). Measured on production
# 2026-09-16: four blocks set a Cache-Control and stopped there, so the emoji font,
# every content-hashed bundle, every .mjs worker and both App Link manifests were
# served with NO nosniff and NO X-Frame-Options - while an HTML page, which reaches
# @ssr and declared nothing, inherited all three correctly. A convention that only
# holds where someone remembered it is the thing a test is for.
#
# connect-src is the list of hosts the APP ITSELF calls, and it must match the code:
#   - static.klipy.com the GIF BYTES, fetched to be encrypted before upload
#     (PostComments.stageMediaFile). Omitting it blocked every GIF comment, silently.
#     Since 2026-10-18 the current bundle reads them through chat-delivery's GIF relay
#     (/api/mls/gifs/media, gifMediaProxy.ts); the host stays for a tab on an older bundle.
#   NOT api.klipy.com, since 2026-10-16: the GIF search goes through chat-delivery's
#   /api/mls/gifs so KLIPY never sees a reader's query, IP or identifier (gifSearch.ts).
# img-src stays wide (https:) because it renders arbitrary user-posted image URLs;
# connect-src must not, since it governs what the app can read into memory. It names
# no bare ws:/wss: either: both WebSockets are same-origin, and the estate's own wss://
# names are listed because 'self' matches wss: only under CSP Level 3 (older Safari).
#
# NO 'unsafe-inline' FOR SCRIPTS, AND A PAGE IS NOT GOVERNED BY THIS SNIPPET (2026-10-22).
# These directives are written ONCE MORE, in frontend/src/lib/security/cspPolicy.js, and
# csp.test.ts holds the two equal: SvelteKit sends that policy on every PAGE, plus the
# hash of each inline script the page carries, which only the build knows. This snippet
# covers every OTHER response - a worker script's policy is its own response's, so the
# MLS worker compiles its WebAssembly under 'wasm-unsafe-eval' from here. A page block
# (@ssr, @app_shell) must NOT include it: a second policy is intersected with the first,
# and this one, holding no hash, would refuse the page's own scripts. It includes
# csp-page.conf instead, which says only what a <meta> policy cannot (frame-ancestors).
RUN mkdir -p /etc/nginx/snippets && printf 'add_header Content-Security-Policy "default-src '"'"'self'"'"'; script-src '"'"'self'"'"' '"'"'wasm-unsafe-eval'"'"'; style-src '"'"'self'"'"' '"'"'unsafe-inline'"'"'; connect-src '"'"'self'"'"' blob: wss://canari.emse.fr wss://canari-emse.fr wss://www.canari-emse.fr wss://dev.canari-emse.fr https://static.klipy.com; img-src '"'"'self'"'"' data: blob: https:; font-src '"'"'self'"'"' data:; worker-src '"'"'self'"'"' blob:; media-src '"'"'self'"'"' blob:; frame-src '"'"'self'"'"'; form-action '"'"'self'"'"'; object-src '"'"'none'"'"'; frame-ancestors '"'"'none'"'"'; base-uri '"'"'self'"'"';" always;\n' > /etc/nginx/snippets/csp.conf
RUN printf 'add_header Content-Security-Policy "frame-ancestors '"'"'none'"'"'" always;\n' > /etc/nginx/snippets/csp-page.conf

# The headers of an error this nginx makes itself on an API route (@api_error_*): JSON, never cached,
# readable cross-origin by the three WebView origins ($api_error_cors_origin, an allowlist - empty
# for anyone else, and nginx sends no header with an empty value), and the three security headers,
# since a block that sets any header loses the inherited ones.
RUN printf 'default_type application/json;\nadd_header Access-Control-Allow-Origin $api_error_cors_origin always;\nadd_header Access-Control-Allow-Credentials "true" always;\nadd_header Vary "Origin" always;\nadd_header Cache-Control "no-store" always;\ninclude /etc/nginx/snippets/csp.conf;\nadd_header X-Content-Type-Options "nosniff" always;\nadd_header X-Frame-Options "DENY" always;\n' > /etc/nginx/snippets/api-error-headers.conf

# SPA fallback + reverse proxy WebSocket/API vers les services Docker
RUN printf '# THE ACCESS LOG NEVER RECORDS A BEARER TOKEN (prod 2026-10-06: every `GET /api/ws` line carried the\n\
# full `token=<JWT>` query, a live credential for its remaining hour, readable by anyone who can read\n\
# the container log). The client puts the token in the query on purpose (WebMlsService, CallService:\n\
# Tauri and proxies that drop the canari_ws_token cookie), so the REQUEST is left alone and only what\n\
# is WRITTEN is rewritten - `$request` is replaced by the same three parts with the `token` value\n\
# redacted, on every route and whichever position it has. The rest of the line is the stock `main`\n\
# format. The format has its own name because redefining `main` is a duplicate-name error.\n\
# A GIF SEARCH IS NOT LOGGED EITHER (2026-10-16): `/api/mls/gifs?q=` exists so a reader'"'"'s search is\n\
# never tied to their address, and this line carries both - so its whole query is dropped. FIRST,\n\
# because a map takes the first rule that matches. The GIF RELAY (`/api/mls/gifs/media?url=`) keeps its\n\
# path but not its query either: which GIF a reader loaded, beside their address, is the association\n\
# the relay exists to keep from KLIPY - our own log must not rebuild it.\n\
# A GUEST RECEIPT IS NOT LOGGED (2026-10-22, paid public forms WP-P2): `/f/<id>/receipt?receipt=` is\n\
# a guest'"'"'s proof of a paid answer, the only one it has, so the route keeps its path and drops its\n\
# query. The page itself sends no Referer (`no-referrer`), so its own requests do not carry it either.\n\
# A PRESENCE READ IS NOT LOGGED WITH ITS IDS (2026-10-28): the legacy `GET /api/presence?users=` names\n\
# every user a member watches, 64 hex characters each, so its line lists who that member follows beside\n\
# their address and grows past what a log scanner accepts. Current clients POST the ids; the query of\n\
# the clients still calling the GET is dropped here (docs/wiki/legacy-compatibility.md).\n\
map $request_uri $logged_request_uri {\n\
    "~^/api/presence[?]" "/api/presence?query-redacted";\n\
    "~^/api/mls/gifs/media(?:[?]|$)" "/api/mls/gifs/media?query-redacted";\n\
    "~^/api/mls/gifs(?:[?/]|$)" "/api/mls/gifs?query-redacted";\n\
    "~^(?<receipt_path>/f/[^/?]+/receipt)[?]" "${receipt_path}?query-redacted";\n\
    "~^(?<uri_before_token>.*[?&])token=[^&]*(?<uri_after_token>.*)$" "${uri_before_token}token=redacted${uri_after_token}";\n\
    default $request_uri;\n\
}\n\
# A PUBLIC FORM PAGE SENDS NO REFERER (2026-10-22, paid public forms WP-P2). `/f/<id>/receipt` carries\n\
# a guest'"'"'s receipt in its query, and the page boots on the client: the first requests it makes (its\n\
# own chunks) leave before any <meta> in it can apply, carrying the whole URL as their Referer. So the\n\
# policy is a HEADER of the page itself, on every `/f/` page. Keyed on $request_uri, which @app_shell'"'"'s\n\
# try_files does not rewrite. An empty value sends no header, so every other page is unchanged.\n\
map $request_uri $public_form_referrer_policy {\n\
    default "";\n\
    "~^/f/" "no-referrer";\n\
}\n\
# FIVE DIAGNOSTIC FIELDS TRAIL THE LINE (2026-10-18), for the intermittent Messenger preview failure the\n\
# access log could not explain: it held two response sizes for one crawler hit and nothing to say why.\n\
# rt = total time; urt and ust = the upstream's time and status (a slow or failing SSR shows here);\n\
# ce = whether THIS response was compressed; deg = the SSR's own admission that it served a degraded\n\
# head (X-Canari-Degraded). Durations, statuses and one header value: no address, cookie or query.\n\
log_format canari_redacted "$remote_addr - $remote_user [$time_local] \\"$request_method $logged_request_uri $server_protocol\\" $status $body_bytes_sent \\"$http_referer\\" \\"$http_user_agent\\" \\"$http_x_forwarded_for\\" rt=$request_time urt=$upstream_response_time ust=$upstream_status ce=$sent_http_content_encoding deg=$sent_http_x_canari_degraded";\n\
\n\
# THE COOKIE ADMINER IS GIVEN: the browser sends the Canari adminer session (canari_adminer) with\n\
# every request on /adminer/, and the upstream has no use for it - it is stripped, and the cookies of Adminer\n\
# itself (adminer_sid, adminer_key ...) are left exactly as they came.\n\
map $http_cookie $adminer_cookie {\n\
    "~^canari_adminer=[^;]*;?\\s*(?<rest>.*)$" $rest;\n\
    "~^(?<head>.*?);\\s*canari_adminer=[^;]*(?:;\\s*(?<tail>.*))?$" "$head; $tail";\n\
    default $http_cookie;\n\
}\n\
\n\
# AN ERROR THIS nginx MAKES ITSELF MUST STILL BE READABLE BY THE PHONE APPS (2026-10-15). They read\n\
# the API through the WebView fetch, cross-origin (frontend/src/lib/utils/fetchRouting.ts), so a\n\
# response without Access-Control-Allow-Origin reaches them as a TypeError - a transport failure,\n\
# which marks the server unreachable - where the status was an ANSWER. The services set the header\n\
# on everything they answer; a 502/504 while one restarts, or the 500 of a failed auth_request, is\n\
# made here and carried none. ALLOWLIST, not a mirror: the three WebView origins of\n\
# TAURI_WEBVIEW_ORIGINS (apps/*/src/cors-origins.ts). The web app is same-origin and needs none.\n\
map $http_origin $api_error_cors_origin {\n\
    default "";\n\
    "http://tauri.localhost" $http_origin;\n\
    "https://tauri.localhost" $http_origin;\n\
    "tauri://localhost" $http_origin;\n\
}\n\
\n\
# A LIVE SEGMENT IS THE ONE UPLOAD A CLIENT SENDS EVERY FEW SECONDS (docs/wiki/services/lives.md).\n\
# The per-account limits are the service (byte budget, segment rate, starts per hour); this is the\n\
# edge ceiling in front of them, per client address (real_ip below). PUT ONLY: viewers polling the\n\
# manifest from one campus address share it, and an empty key is never limited. 2 r/s is four times\n\
# the planned rate of one broadcaster (a segment every 2-3 s); the burst absorbs a reconnect.\n\
map $request_method $lives_ingest_key {\n\
    default "";\n\
    PUT $binary_remote_addr;\n\
}\n\
limit_req_zone $lives_ingest_key zone=lives_ingest:1m rate=2r/s;\n\
\n\
# THE SEALED SEGMENTS OF A LIVE LEAVE THE STORE ONCE PER SEGMENT, NOT ONCE PER VIEWER (WP-L4,\n\
# docs/wiki/services/lives.md "Serving a segment"). Every viewer of a live fetches the SAME ciphertext\n\
# by the SAME name, so this cache answers all but the first, and `proxy_cache_lock` makes the viewers\n\
# that arrive together wait for that first one instead of each reaching media-service. Sizes:\n\
# 2 min (`inactive`, and `proxy_cache_valid 200` below) is far past the manifest window a viewer reads\n\
# from (10 segments of a few seconds), and it bounds how long a segment outlives the purge of its live here.\n\
# 512 MB holds ~10 lives at the planned 3 Mb/s: a segment stays ~140 s (read for ~20 s, then 2 min\n\
# inactive), so ~52 MB a live (docs/wiki/frontend/modules/live-scaling.md); past it the oldest go first, which costs\n\
# a refetch, never an error. `use_temp_path=off` writes a response straight into this directory.\n\
proxy_cache_path /var/cache/nginx/live levels=1:2 keys_zone=live_segments:1m max_size=512m inactive=2m use_temp_path=off;\n\
# The segment route is unauthenticated, so it has an edge ceiling of its own, per client address. A\n\
# whole campus may share ONE address: 30 r/s is the whole viewer cap of the host (24 seats, lives.md)\n\
# fetching a segment a second, with room to spare; the burst absorbs a player catching up.\n\
limit_req_zone $binary_remote_addr zone=lives_segments:1m rate=30r/s;\n\
# limit_req counts REQUESTS, not bytes: 30 r/s of 4 MiB segments is ~1 Gb/s from one address. So the\n\
# BYTES are bounded too, per address, from the plan's own numbers (live.constants.ts): at most 24\n\
# segment fetches at once (limit_conn below: the viewer cap, so a FULL audience behind ONE campus\n\
# address is never refused), each sent at 750 000 B/s (limit_rate: twice the 3 Mb/s a viewer costs, so\n\
# a 3 s segment arrives in 1.5 s and a player can catch up). THE TRADE-OFF, stated: both cannot hold\n\
# with the live share of the uplink (24 x 3 Mb/s = 72 Mb/s) - 24 fetches at 2x would need twice it. We\n\
# do not throttle honest viewers, so ONE address is bounded at 24 x 6 Mb/s = 144 Mb/s, twice the live\n\
# share and above the measured link: a COARSE protection (against ~1 Gb/s unbounded), not the uplink\n\
# budget - that is the seat cap, for an honest client. live-segments-route.test.mjs recomputes both\n\
# bounds from the constants. (nginx grants each response one second of head start, so a single short\n\
# fetch runs a little faster than the rate.)\n\
limit_conn_zone $binary_remote_addr zone=lives_segments_conn:1m;\n\
\n\
# THE CACHE-CONTROL OF AN SSR RESPONSE, decided in two steps.\n\
# 1. A response that DECLARED its own public max-age keeps it: routes/sitemap.xml/+server.ts is\n\
#    prerender=false, so it is served through @ssr, and its 1 h is a budget it set for itself.\n\
#    An SSR page declares none (adapter-node sets no Cache-Control), so it takes the default:\n\
#    shared-cacheable for 60 s (see @ssr).\n\
map $upstream_http_cache_control $ssr_cache_control_declared {\n\
    default "public, max-age=0, s-maxage=60";\n\
    "~^public, max-age=[0-9]+$" $upstream_http_cache_control;\n\
}\n\
# 2. EXCEPT a response the SSR itself marked degraded (`X-Canari-Degraded`, any value), which is\n\
#    `no-store` whatever it declared.\n\
map $upstream_http_x_canari_degraded $ssr_cache_control {\n\
    default $ssr_cache_control_declared;\n\
    "~." "no-store";\n\
}\n\
# THE LYDIA CALLBACK IS THE ONE PUBLIC POST THAT READS A KEY AND THEN ASKS LYDIA (payments.md): a\n\
# signature is checked per call against a Business key fetched from social-service, and a verified\n\
# one makes social-service read the request at Lydia. Lydia sends a handful per payment; 5 r/s burst\n\
# 50 per client address is far above that and bounds what a flood of forged bodies can cost.\n\
map $request_method $lydia_callback_key {\n\
    default "";\n\
    POST $binary_remote_addr;\n\
}\n\
limit_req_zone $lydia_callback_key zone=lydia_callback:1m rate=5r/s;\n\
\n\
server {\n\
    listen 80;\n\
    # SERVER LEVEL ON PURPOSE: the base image's nginx.conf declares `access_log ... main` at http level,\n\
    # and one declared at http level here would ADD to it, writing the unredacted line beside the\n\
    # redacted one. Declared in this block it REPLACES what is inherited.\n\
    access_log /var/log/nginx/access.log canari_redacted;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    # Limite d\'upload pour les médias (évite les 413 nginx par défaut ~1MB)\n\
    client_max_body_size 100m;\n\
    # THE ORIGIN COMPRESSES EVERYTHING TEXT-SHAPED, THE WASM INCLUDED (2026-10-09). It used to name\n\
    # `application/json` alone, so the 2.1 MB MLS engine, the 240 kB stylesheet and ~2 MB of\n\
    # JavaScript left this container raw. Measured on production that day (`curl` with\n\
    # `Accept-Encoding: br,gzip`, DNS straight to the host, no CDN in front): no Content-Encoding\n\
    # on any of them, 2 126 190 bytes for the WASM. On Slow 3G that is the difference between a\n\
    # cold start of ~100 s and one of ~40 s ([offline-and-weak-network](docs/wiki/frontend/offline-and-weak-network.md)).\n\
    # `gzip_proxied any`: the host proxy in front of this container adds a `Via` header, and nginx\n\
    # refuses to compress a request that carries one unless told otherwise - a silent no-op that a\n\
    # direct `curl` to the container would never reveal. `gzip_vary` because the same URL now has\n\
    # two representations. woff2 and images are already compressed and stay out of the list.\n\
    # No brotli: the stock image has no such module, and a module built against a different nginx\n\
    # is a worse failure than the extra bytes it would save.\n\
    gzip on;\n\
    gzip_comp_level 6;\n\
    gzip_proxied any;\n\
    gzip_vary on;\n\
    gzip_types application/json application/javascript text/javascript text/css application/wasm image/svg+xml application/manifest+json application/xml text/plain;\n\
    gzip_min_length 256;\n\
    proxy_buffering off;\n\
    tcp_nodelay on;\n\
    \n\
    # Utilise le resolver DNS interne de Docker pour la résolution des upstreams\n\
    # Cela évite que nginx refuse de démarrer si un upstream est temporairement absent\n\
    #\n\
    # A RELEASE REPLACES A SERVICE WITHOUT A GAP, AND THESE THREE LINES ARE WHAT LET IT (2026-10-17,\n\
    # docs/wiki/cicd.md#a-deploy-replaces-nothing-a-member-is-talking-to). The new replica starts beside\n\
    # the old one, so a name resolves to BOTH for a while; the old one then stops listening and finishes\n\
    # what it holds. `valid=2s` is how long an address is kept - the deploy waits that long (it reads\n\
    # the same number, asserted by deploy-replace.test.sh) before retiring the old replica, so every\n\
    # request after it already knows the new one. A connect REFUSED by the old replica is handed to the\n\
    # next address with no byte sent, POSTs included; `proxy_connect_timeout 2s` bounds the one case that\n\
    # is not a refusal - an address whose container has just gone, still cached for at most 2 s - where\n\
    # the default would hold a member for 60 s. A connect on this bridge takes well under a millisecond.\n\
    resolver 127.0.0.11 valid=2s ipv6=off;\n\
    proxy_connect_timeout 2s;\n\
    proxy_next_upstream error timeout;\n\
    # EVERY VISITOR ARRIVES FROM THE DOCKER GATEWAY, SO $remote_addr NAMED NOBODY.\n\
    # The host proxy in front of this container sets X-Real-IP to the real client\n\
    # (after its own real_ip), and until 2026-09-30 every location overwrote it with\n\
    # the gateway: prod logged 172.25.0.1 for all traffic, and a per-IP throttle\n\
    # upstream was ONE bucket for everybody. Only a private hop may name the client.\n\
    set_real_ip_from 127.0.0.1;\n\
    set_real_ip_from 172.16.0.0/12;\n\
    set_real_ip_from 10.0.0.0/8;\n\
    real_ip_header X-Real-IP;\n\
    # A CLIENT MAY SEND ANY HEADER IT LIKES, AND nginx FORWARDS THE ONES NOBODY OVERRODE.\n\
    # These five names are what the services READ to decide who is calling, so they are\n\
    # emptied here and re-set from the auth sub-request in each guarded location. The list\n\
    # must be the app-facing spelling, not the sub-request's: `auth_request_set` reads\n\
    # `X-Logged-In` off /internal/auth/verify and forwards it as `X-User-Logged-In`, and\n\
    # until 2026-09-17 this block cleared the FORMER - a name no service has ever read -\n\
    # while leaving the latter untouched. `X-Internal-Token` was not here at all.\n\
    #\n\
    # NOTHING WAS EXPLOITABLE, AND THE REASON IS NOT THIS BLOCK. nginx inherits a\n\
    # proxy_set_header set only into a location that declares NONE of its own, and all 24\n\
    # proxying locations declare theirs - so these lines currently reach nothing. They are\n\
    # the net for the NEXT location somebody adds, which is exactly when a half-empty net\n\
    # is discovered. `auth-request-coverage.test.mjs` asserts the five names are all here.\n\
    proxy_set_header X-User-Id "";\n\
    proxy_set_header X-User-Logged-In "false";\n\
    proxy_set_header X-Global-Admin "false";\n\
    proxy_set_header X-Internal-Token "";\n\
    proxy_set_header X-Session-Id "";\n\
    \n\
    include /etc/nginx/snippets/csp.conf;\n\
    add_header X-Content-Type-Options "nosniff" always;\n\
    add_header X-Frame-Options "DENY" always;\n\
    \n\
    # The errors this nginx makes, answered with the allowlisted origin (see the map above). Only an\n\
    # error MADE HERE reaches these: proxy_intercept_errors is off, so a 5xx a service answers passes\n\
    # through with its own CORS headers. `location /` declares its own error_page (the app shell)\n\
    # and so does not inherit this; the other locations serve files and make no 5xx of their own.\n\
    # 413 and 429 too (2026-10-18): client_max_body_size and limit_req answer them HERE, and a\n\
    # broadcaster told "too large" or "too fast" must read a status, not a transport failure.\n\
    error_page 413 @api_error_413;\n\
    error_page 429 @api_error_429;\n\
    error_page 500 @api_error_500;\n\
    error_page 502 @api_error_502;\n\
    error_page 503 @api_error_503;\n\
    error_page 504 @api_error_504;\n\
    location @api_error_413 {\n\
    include /etc/nginx/snippets/api-error-headers.conf;\n\
    return 413 "{\\"statusCode\\":413,\\"message\\":\\"request body too large\\"}";\n\
    }\n\
    location @api_error_429 {\n\
    include /etc/nginx/snippets/api-error-headers.conf;\n\
    return 429 "{\\"statusCode\\":429,\\"message\\":\\"too many requests\\"}";\n\
    }\n\
    location @api_error_500 {\n\
    include /etc/nginx/snippets/api-error-headers.conf;\n\
    return 500 "{\\"statusCode\\":500,\\"message\\":\\"edge error\\"}";\n\
    }\n\
    location @api_error_502 {\n\
    include /etc/nginx/snippets/api-error-headers.conf;\n\
    return 502 "{\\"statusCode\\":502,\\"message\\":\\"upstream unavailable\\"}";\n\
    }\n\
    location @api_error_503 {\n\
    include /etc/nginx/snippets/api-error-headers.conf;\n\
    return 503 "{\\"statusCode\\":503,\\"message\\":\\"upstream unavailable\\"}";\n\
    }\n\
    location @api_error_504 {\n\
    include /etc/nginx/snippets/api-error-headers.conf;\n\
    return 504 "{\\"statusCode\\":504,\\"message\\":\\"upstream timed out\\"}";\n\
    }\n\
    \n\
    location = /internal/auth/verify {\n\
    internal;\n\
    set $upstream_auth core-service:3012;\n\
    proxy_pass http://$upstream_auth/api/auth/verify;\n\
    proxy_pass_request_body off;\n\
    proxy_set_header Content-Length "";\n\
    proxy_set_header X-Original-URI $request_uri;\n\
    proxy_set_header Authorization $http_authorization;\n\
    proxy_set_header Cookie $http_cookie;\n\
    }\n\
    \n\
    # ADMINER, THE DATABASE ADMIN UI - GLOBAL ADMINS ONLY, AND CLOSED BY DEFAULT (2026-10-02).\n\
    # A page reached by NAVIGATION carries no Authorization header, so /internal/auth/verify cannot\n\
    # identify its caller; the gate below reads a short, signed, HttpOnly cookie that a global admin\n\
    # is handed by POST /api/auth/adminer-session (core-service), and core-service re-checks on every\n\
    # request that its owner is STILL an admin. Anything that is not a live session answers a bare\n\
    # 404, so a visitor learns nothing about what lives here. Adminer then asks for the database user\n\
    # and password itself: this block never holds or injects one. Where ADMINER_ENABLED is not set\n\
    # (development) core-service refuses to issue the cookie and there is no adminer upstream at all.\n\
    # docs/wiki/infrastructure/databases.md; .github/scripts/tests/adminer-route.test.mjs holds the shape.\n\
    location = /internal/auth/adminer {\n\
    internal;\n\
    set $upstream_auth core-service:3012;\n\
    proxy_pass http://$upstream_auth/api/auth/adminer-verify;\n\
    proxy_pass_request_body off;\n\
    proxy_set_header Content-Length "";\n\
    proxy_set_header Cookie $http_cookie;\n\
    }\n\
    \n\
    location = /adminer {\n\
    absolute_redirect off;\n\
    return 301 /adminer/;\n\
    }\n\
    \n\
    location @adminer_hidden {\n\
    return 404;\n\
    }\n\
    \n\
    location /adminer/ {\n\
    auth_request /internal/auth/adminer;\n\
    error_page 401 403 =404 @adminer_hidden;\n\
    limit_except GET HEAD POST { deny all; }\n\
    # The upstream is addressed through a variable, so the prefix is stripped by hand. THE `set` COMES\n\
    # FIRST, and the order is the whole point: `rewrite ... break` ends the rewrite phase, so a `set`\n\
    # written after it never runs and proxy_pass is handed an empty host (a 500, found by running it).\n\
    # Adminer answers its redirects RELATIVELY (?pgsql=...), which a browser resolves under /adminer/ by\n\
    # itself, so there is no proxy_redirect: one written for absolute paths would be a guess.\n\
    set $upstream_adminer adminer:8080;\n\
    rewrite ^/adminer/(.*)$ /$1 break;\n\
    proxy_pass http://$upstream_adminer;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    proxy_set_header Cookie $adminer_cookie;\n\
    proxy_set_header X-User-Id "";\n\
    proxy_set_header X-User-Logged-In "false";\n\
    proxy_set_header X-Global-Admin "false";\n\
    proxy_set_header X-Internal-Token "";\n\
    proxy_set_header X-Session-Id "";\n\
    proxy_read_timeout 300s;\n\
    proxy_send_timeout 300s;\n\
    add_header Cache-Control "no-store" always;\n\
    add_header X-Robots-Tag "noindex, nofollow" always;\n\
    add_header Referrer-Policy "no-referrer" always;\n\
    add_header Content-Security-Policy "default-src '"'"'self'"'"'; script-src '"'"'self'"'"' '"'"'unsafe-inline'"'"'; style-src '"'"'self'"'"' '"'"'unsafe-inline'"'"'; img-src '"'"'self'"'"' data:; connect-src '"'"'self'"'"'; form-action '"'"'self'"'"'; frame-ancestors '"'"'none'"'"'; base-uri '"'"'self'"'"'; object-src '"'"'none'"'"';" always;\n\
    add_header X-Content-Type-Options "nosniff" always;\n\
    add_header X-Frame-Options "DENY" always;\n\
    }\n\
    \n\
    # App Links Android (assetlinks.json) + Universal Links iOS\n\
    # (apple-app-site-association), prerendus dans build/.well-known/.\n\
    location /.well-known/ {\n\
    try_files $uri =404;\n\
    add_header Content-Type application/json;\n\
    add_header Cache-Control "public, max-age=3600";\n\
    include /etc/nginx/snippets/csp.conf;\n\
    add_header X-Content-Type-Options "nosniff" always;\n\
    add_header X-Frame-Options "DENY" always;\n\
    }\n\
    \n\
    location /_app/immutable/ {\n\
    try_files $uri =404;\n\
    add_header Cache-Control "public, max-age=31536000, immutable";\n\
    include /etc/nginx/snippets/csp.conf;\n\
    add_header X-Content-Type-Options "nosniff" always;\n\
    add_header X-Frame-Options "DENY" always;\n\
    }\n\
    \n\
    # nginx mime.types has no .mjs entry, so an ES module shipped as a build\n\
    # asset (the pdf.js worker) was served as application/octet-stream and the\n\
    # browser module loader refused it. A regex location wins over the prefix\n\
    # one above, so the caching has to be repeated here.\n\
    location ~* \.mjs$ {\n\
    try_files $uri =404;\n\
    default_type application/javascript;\n\
    add_header Cache-Control "public, max-age=31536000, immutable";\n\
    include /etc/nginx/snippets/csp.conf;\n\
    add_header X-Content-Type-Options "nosniff" always;\n\
    add_header X-Frame-Options "DENY" always;\n\
    }\n\
    \n\
    # The root has to be matched exactly. There is no index.html any more, so\n\
    # "try_files $uri" on "/" would test a DIRECTORY, hand the request to the\n\
    # index module and answer 403 - the one path that cannot reach @ssr on its\n\
    # own. An exact location skips that machinery entirely.\n\
    location = / {\n\
    try_files /nonexistent @ssr;\n\
    }\n\
    \n\
    # The compose healthcheck of THIS container (2026-10-17): it answers from here alone, so healthy\n\
    # means this configuration loaded and the server listens - the moment the edge may send it\n\
    # traffic and a release may retire the replica it replaces. Not logged: a line every 30 s per\n\
    # replica would be noise that names nobody.\n\
    location = /nginx-health {\n\
    access_log off;\n\
    return 200;\n\
    }\n\
    \n\
    # The emoji pictures (docs/wiki/frontend/emoji.md). Their directory is a hash\n\
    # of every name and byte in the set (tools/emoji-svg/build.mjs), so a picture\n\
    # whose content changes changes URL: that is what makes `immutable` for a year\n\
    # safe, and a browser fetch each emoji once.\n\
    location /emoji/ {\n\
    try_files $uri =404;\n\
    add_header Cache-Control "public, max-age=31536000, immutable";\n\
    include /etc/nginx/snippets/csp.conf;\n\
    add_header X-Content-Type-Options "nosniff" always;\n\
    add_header X-Frame-Options "DENY" always;\n\
    }\n\
    \n\
    # No $uri/ here on purpose: every directory under the root has its own\n\
    # location, so the only thing $uri/ can still do is re-open the 403 above.\n\
    #\n\
    # WHAT THIS BLOCK ACTUALLY SERVES, AND WHY ITS HEADERS WERE INVERTED. `try_files\n\
    # $uri @ssr` means nginx answers from THIS block only when the path is a file on\n\
    # disk - the PWA icons, the web manifest, the emoji data. A page\n\
    # falls through to @ssr, and a named location handles the request itself, so an\n\
    # `add_header` here never reached one. The `Cache-Control: no-store` that stood\n\
    # here was therefore stamped on every immutable asset in static/ and on none of\n\
    # the HTML it was written for; it now lives in @ssr, where the page is.\n\
    #\n\
    # Measured on production 2026-09-16, and this is what it cost: the emoji font\n\
    # answered `cf-cache-status: BYPASS` with `Cache-Control: no-store`, so its\n\
    # 5 705 472 bytes crossed from the origin on EVERY page load, uncacheable by the\n\
    # browser and by the edge alike. Preloaded from app.html, it went first and held\n\
    # the link at ~477 kB/s while the 723 kB MLS binary queued behind it at 54 kB/s\n\
    # and took 13 286 ms of a 15-second start-up.\n\
    #\n\
    # The three security headers are repeated rather than inherited: nginx drops the\n\
    # server-level add_header set as soon as a location declares one of its own, and\n\
    # this block did - so every file it served was missing nosniff and X-Frame-Options\n\
    # (measured on the same day: 0 of 2 present on the font, 2 of 2 on an HTML page,\n\
    # which reaches @ssr and declares nothing). Cache-Control is deliberately NOT\n\
    # `always`: a 404 from here must not be cached, and nginx skips a non-always\n\
    # header on a 4xx.\n\
    location / {\n\
    try_files $uri @ssr;\n\
    add_header Cache-Control "public, max-age=3600";\n\
    include /etc/nginx/snippets/csp.conf;\n\
    add_header X-Content-Type-Options "nosniff" always;\n\
    add_header X-Frame-Options "DENY" always;\n\
    }\n\
    \n\
    # HTML navigations -> the SvelteKit server (adapter-node), which writes the\n\
    # per-page Open Graph tags into the shell. A failure here falls through to\n\
    # @app_shell rather than 502-ing the whole site.\n\
    location @ssr {\n\
    set $upstream_ssr frontend-ssr:3000;\n\
    proxy_pass http://$upstream_ssr;\n\
    proxy_http_version 1.1;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    proxy_read_timeout 30s;\n\
    # SvelteKit answers every page with a Link: rel=modulepreload header listing\n\
    # ~130 chunks - about 7.5 KB, where nginx allocates 4 KB for the whole\n\
    # upstream header by default. It does not truncate: it logs "upstream sent\n\
    # too big header" and answers 502, so EVERY navigation failed while the\n\
    # upstream itself was healthy. 32k leaves room for the list to grow.\n\
    proxy_buffer_size 32k;\n\
    proxy_buffers 8 32k;\n\
    proxy_busy_buffers_size 64k;\n\
    # THE PAGE MAY BE CACHED WHERE A PURGE CAN REACH IT, AND NOWHERE ELSE. That is the\n\
    # whole of `max-age=0, s-maxage=60`, and the two halves answer two different\n\
    # questions. A deploy replaces this shell with one naming different content-hashed\n\
    # chunks, and the old chunks are NOT in the new image - so a shell that outlives its\n\
    # build is a BLANK page, not an old one. A shared cache can be told to forget:\n\
    # `serve-prod.yml` purges the zone once the new containers answer. A browser cache\n\
    # cannot be told anything at all, which is why the browser's own TTL stays 0.\n\
    #\n\
    # 60 SECONDS IS THE SMALLER OF TWO NUMBERS THAT AGREE. It is the freshness budget\n\
    # `serverSeo.ts` already set itself for the same bytes ("an edited post should not\n\
    # keep previewing its old title for long"), and it is the ceiling on how long a\n\
    # stale shell could break the site if the purge ever failed to run. There is\n\
    # deliberately no `stale-while-revalidate`: it would buy hit-rate this site does not\n\
    # need and extend exactly that window.\n\
    #\n\
    # Until 2026-09-17 this said `no-store`, which was right when it was written: the\n\
    # no-store meant for the page had been sitting in `location /`, which only ever\n\
    # answers for a file on disk, and an HTML navigation carried no Cache-Control at\n\
    # all. Putting it here fixed that. What it could not know is that the origin round\n\
    # trip it made unconditional is 94 ms of every navigation, measured in the user's\n\
    # own browser. adapter-node sets no Cache-Control of its own on an SSR response, so\n\
    # this is still the only declaration and there is no second header to reconcile.\n\
    #\n\
    # The three security headers are repeated because nginx drops the whole\n\
    # server-level add_header set from a location that declares one of its own. This\n\
    # block declared none, which is how HTML kept CSP, nosniff and X-Frame-Options by\n\
    # inheritance; adding Cache-Control here would have stripped all three from every\n\
    # navigation on the site.\n\
    # A DEGRADED HEAD IS NEVER OFFERED TO A CACHE (2026-10-18). When the enrichment of a page got\n\
    # no answer, frontend-ssr serves the generic head and says so with `X-Canari-Degraded`; the\n\
    # map `$ssr_cache_control` turns that into `no-store` here, where the one Cache-Control of this\n\
    # block is decided. Without it the 60 s above pinned the generic card at the edge for a minute,\n\
    # and every unfurler retry inside it was handed the same failure. The upstream's own\n\
    # Cache-Control is hidden and re-emitted by the map, so there is ONE declaration: a page gets the\n\
    # default, and the sitemap's own public max-age passes through the first map unchanged.\n\
    proxy_hide_header Cache-Control;\n\
    add_header Cache-Control $ssr_cache_control always;\n\
    add_header Referrer-Policy $public_form_referrer_policy always;\n\
    # THE CONTENT-SECURITY-POLICY OF A PAGE IS WRITTEN BY SVELTEKIT (kit.csp, hash mode), passed from the\n\
    # upstream with the hash of each inline script; csp.conf here would be intersected with it and\n\
    # refuse those scripts. csp-page.conf adds only frame-ancestors (see the snippet comment above).\n\
    include /etc/nginx/snippets/csp-page.conf;\n\
    add_header X-Content-Type-Options "nosniff" always;\n\
    add_header X-Frame-Options "DENY" always;\n\
    error_page 502 503 504 =200 @app_shell;\n\
    }\n\
    \n\
    # NOTE: `=200` on the error_page above, and it was measured rather than chosen.\n\
    # Preserving the 5xx would be better for a crawler (a status it retries, instead of a\n\
    # 200 whose head is the generic one), and a browser runs the scripts of a 5xx body\n\
    # anyway - but Cloudflare REPLACES the body of an origin 5xx with its own\n\
    # "error code: 502" plain-text page, so the shell never reaches anyone. A degraded\n\
    # <head> is the cost of the fallback; the site being unreachable is not.\n\
    # adapter-node emits no index.html, so without this the frontend-ssr container\n\
    # being down means a 502 on EVERY navigation - the whole site, to spare the\n\
    # per-page head. app-shell.html is prerendered (routes/app-shell/) and boots the\n\
    # SPA on whatever URL was asked for, exactly as the static build always did.\n\
    # Degraded, not broken: only the injected <head> is missing.\n\
    location @app_shell {\n\
    try_files /app-shell.html =502;\n\
    add_header Cache-Control "no-store" always;\n\
    add_header X-Canari-Degraded "ssr-unavailable" always;\n\
    add_header Referrer-Policy $public_form_referrer_policy always;\n\
    # The prerendered shell carries its policy as a <meta> (kit.csp, hashes included), which cannot\n\
    # say frame-ancestors - csp-page.conf says it.\n\
    include /etc/nginx/snippets/csp-page.conf;\n\
    add_header X-Content-Type-Options "nosniff" always;\n\
    add_header X-Frame-Options "DENY" always;\n\
    }\n\
    \n\
    location /api/ws {\n\
    auth_request /internal/auth/verify;\n\
    auth_request_set $user_id $upstream_http_x_user_id;\n\
    auth_request_set $user_logged_in $upstream_http_x_logged_in;\n\
    auth_request_set $global_admin $upstream_http_x_global_admin;\n\
    auth_request_set $internal_token $upstream_http_x_internal_token;\n\
    auth_request_set $session_id $upstream_http_x_session_id;\n\
    proxy_set_header X-User-Id $user_id;\n\
    proxy_set_header X-User-Logged-In $user_logged_in;\n\
    proxy_set_header X-Global-Admin $global_admin;\n\
    proxy_set_header X-Internal-Token $internal_token;\n\
    proxy_set_header X-Session-Id $session_id;\n\
    set $upstream_gateway chat-gateway:3000;\n\
    proxy_pass http://$upstream_gateway;\n\
    proxy_http_version 1.1;\n\
    proxy_set_header Upgrade $http_upgrade;\n\
    proxy_set_header Connection "upgrade";\n\
    proxy_set_header Cookie $http_cookie;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    proxy_read_timeout 120s;\n\
    proxy_send_timeout 120s;\n\
    }\n\
    \n\
    location /api/admin {\n\
    auth_request /internal/auth/verify;\n\
    auth_request_set $user_id $upstream_http_x_user_id;\n\
    auth_request_set $user_logged_in $upstream_http_x_logged_in;\n\
    auth_request_set $global_admin $upstream_http_x_global_admin;\n\
    auth_request_set $internal_token $upstream_http_x_internal_token;\n\
    auth_request_set $session_id $upstream_http_x_session_id;\n\
    proxy_set_header X-User-Id $user_id;\n\
    proxy_set_header X-User-Logged-In $user_logged_in;\n\
    proxy_set_header X-Global-Admin $global_admin;\n\
    proxy_set_header X-Internal-Token $internal_token;\n\
    proxy_set_header X-Session-Id $session_id;\n\
    set $upstream_gateway chat-gateway:3000;\n\
    proxy_pass http://$upstream_gateway;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    }\n\
    \n\
    location /api/presence {\n\
    auth_request /internal/auth/verify;\n\
    auth_request_set $user_id $upstream_http_x_user_id;\n\
    auth_request_set $user_logged_in $upstream_http_x_logged_in;\n\
    auth_request_set $global_admin $upstream_http_x_global_admin;\n\
    auth_request_set $internal_token $upstream_http_x_internal_token;\n\
    auth_request_set $session_id $upstream_http_x_session_id;\n\
    proxy_set_header X-User-Id $user_id;\n\
    proxy_set_header X-User-Logged-In $user_logged_in;\n\
    proxy_set_header X-Global-Admin $global_admin;\n\
    proxy_set_header X-Internal-Token $internal_token;\n\
    proxy_set_header X-Session-Id $session_id;\n\
    set $upstream_gateway chat-gateway:3000;\n\
    proxy_pass http://$upstream_gateway;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    }\n\
    \n\
    location = /api/chat-delivery-health {\n\
    set $upstream_delivery_health chat-delivery-service:3010;\n\
    proxy_pass http://$upstream_delivery_health/api/health;\n\
    proxy_http_version 1.1;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    }\n\
    \n\
    location = /api/version {\n\
    set $upstream_version core-service:3012;\n\
    proxy_pass http://$upstream_version/api/version;\n\
    proxy_http_version 1.1;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    }\n\
    \n\
    location /api/calls/ {\n\
    auth_request /internal/auth/verify;\n\
    auth_request_set $user_id $upstream_http_x_user_id;\n\
    auth_request_set $user_logged_in $upstream_http_x_logged_in;\n\
    auth_request_set $global_admin $upstream_http_x_global_admin;\n\
    auth_request_set $internal_token $upstream_http_x_internal_token;\n\
    auth_request_set $session_id $upstream_http_x_session_id;\n\
    proxy_set_header X-User-Id $user_id;\n\
    proxy_set_header X-User-Logged-In $user_logged_in;\n\
    proxy_set_header X-Global-Admin $global_admin;\n\
    proxy_set_header X-Internal-Token $internal_token;\n\
    proxy_set_header X-Session-Id $session_id;\n\
    set $upstream_calls chat-delivery-service:3010;\n\
    proxy_pass http://$upstream_calls;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    }\n\
    \n\
    location /api/call {\n\
    auth_request /internal/auth/verify;\n\
    auth_request_set $user_id $upstream_http_x_user_id;\n\
    auth_request_set $user_logged_in $upstream_http_x_logged_in;\n\
    auth_request_set $global_admin $upstream_http_x_global_admin;\n\
    auth_request_set $internal_token $upstream_http_x_internal_token;\n\
    auth_request_set $session_id $upstream_http_x_session_id;\n\
    proxy_set_header X-User-Id $user_id;\n\
    proxy_set_header X-User-Logged-In $user_logged_in;\n\
    proxy_set_header X-Global-Admin $global_admin;\n\
    proxy_set_header X-Internal-Token $internal_token;\n\
    proxy_set_header X-Session-Id $session_id;\n\
    set $upstream_call call-service:3004;\n\
    rewrite ^/api/call(.*) /ws$1 break;\n\
    proxy_pass http://$upstream_call;\n\
    proxy_http_version 1.1;\n\
    proxy_set_header Upgrade $http_upgrade;\n\
    proxy_set_header Connection "upgrade";\n\
    proxy_set_header Cookie $http_cookie;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    proxy_read_timeout 3600s;\n\
    proxy_send_timeout 3600s;\n\
    }\n\
    \n\
    location /api/mls/ {\n\
    auth_request /internal/auth/verify;\n\
    auth_request_set $user_id $upstream_http_x_user_id;\n\
    auth_request_set $user_logged_in $upstream_http_x_logged_in;\n\
    auth_request_set $global_admin $upstream_http_x_global_admin;\n\
    auth_request_set $internal_token $upstream_http_x_internal_token;\n\
    auth_request_set $session_id $upstream_http_x_session_id;\n\
    proxy_set_header X-User-Id $user_id;\n\
    proxy_set_header X-User-Logged-In $user_logged_in;\n\
    proxy_set_header X-Global-Admin $global_admin;\n\
    proxy_set_header X-Internal-Token $internal_token;\n\
    proxy_set_header X-Session-Id $session_id;\n\
    set $upstream_delivery chat-delivery-service:3010;\n\
    proxy_pass http://$upstream_delivery;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    }\n\
    location /api/public/ {\n\
    if ($request_method = OPTIONS) {\n\
    add_header Access-Control-Allow-Origin "*" always;\n\
    add_header Access-Control-Allow-Methods "GET, OPTIONS" always;\n\
    add_header Access-Control-Max-Age 3600 always;\n\
    add_header Content-Length 0;\n\
    return 204;\n\
    }\n\
    # THIS LOCATION OWNS ITS CORS HEADERS, AND THE UPSTREAM MAY NOT ADD MORE.\n\
    # social-service allowlists localhost and 127.0.0.1 origins and echoes them\n\
    # back with Allow-Credentials, so a request from a localhost origin left here\n\
    # carrying TWO Access-Control-Allow-Origin headers - the echo and the star.\n\
    # Two of that header is invalid: every browser blocks the response, and so\n\
    # does the universal fetch in SvelteKit, which is how it surfaced: the\n\
    # portal 503ing on every detail page in dev. One layer answers CORS here,\n\
    # and the allowlist upstream is for the credentialed routes only.\n\
    proxy_hide_header Access-Control-Allow-Origin;\n\
    proxy_hide_header Access-Control-Allow-Credentials;\n\
    add_header Access-Control-Allow-Origin "*" always;\n\
    # Strip client-supplied trust headers: this public location defines its own\n\
    # proxy_set_header directives, so nginx does NOT inherit the server-level resets.\n\
    proxy_set_header X-User-Id "";\n\
    proxy_set_header X-User-Logged-In "false";\n\
    proxy_set_header X-Global-Admin "false";\n\
    proxy_set_header X-Internal-Token "";\n\
    proxy_set_header X-Session-Id "";\n\
    set $upstream_public social-service:3014;\n\
    proxy_pass http://$upstream_public;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    }\n\
    location /api/media/public/ {\n\
    # Strip client-supplied trust headers (no server-level inheritance here).\n\
    proxy_set_header X-User-Id "";\n\
    proxy_set_header X-User-Logged-In "false";\n\
    proxy_set_header X-Global-Admin "false";\n\
    proxy_set_header X-Internal-Token "";\n\
    proxy_set_header X-Session-Id "";\n\
    set $upstream_media_public media-service:3011;\n\
    proxy_pass http://$upstream_media_public;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    }\n\
    # ONE SEALED LIVE SEGMENT, NO TOKEN, ANSWERED FROM THIS CACHE (WP-L4, docs/wiki/services/lives.md\n\
    # "Serving a segment"). The bytes are ciphertext under the live key, which only social-service hands\n\
    # out; the names are random uuids learned only from the manifest.\n\
    # THE WHOLE PREFIX IS OWNED HERE, `^~`: no regex location is tried after it, and nothing under\n\
    # /api/media/public/live/ can fall into /api/media/public/ (no cache, no limit) - an upper-case id,\n\
    # a trailing slash or any other spelling of a segment would have reached the store on every request\n\
    # (review of #2105). Inside, ONE regex: two lower-case uuids and nothing after; everything else is\n\
    # a 404 HERE. media-service refuses any non-canonical path a second time, for the other locations.\n\
    # The regex ends in `\\z`, NOT `$`: PCRE's `$` also matches before a FINAL NEWLINE, so a trailing\n\
    # %%0A matched, and `proxy_pass ...$uri` then wrote a raw LF into the upstream request line - never\n\
    # cached, so every such request reached media-service (second review of #2105).\n\
    # - THE UPSTREAM REQUEST IS THE SAME FOR EVERY VIEWER: the key is the path alone (a query string is\n\
    #   neither in the key nor forwarded, so no viewer can bust the cache), and the cookie, the token,\n\
    #   the origin and any range are dropped. A range is answered by this nginx from the cached whole:\n\
    #   `proxy_force_ranges on`, since media-service sends no Accept-Ranges and nginx would otherwise\n\
    #   answer every Range with the whole 200.\n\
    # - `proxy_buffering on` HERE: it is off server-wide, and an unbuffered response is never cached.\n\
    # - Media-service sends no Cache-Control; whatever an upstream sends is ignored for the cache and\n\
    #   hidden from the client, so the header below is the one policy: `private` (no shared cache\n\
    #   between here and the viewer keeps a segment) and 2 min, the same bound as this cache: a viewer\n\
    #   reads a segment once, within the manifest window, and the ciphertext of an ended live must not\n\
    #   sit in a device's HTTP cache for an hour after it (register C16). No `immutable`, likewise.\n\
    # - THE BYTES ARE BOUNDED PER ADDRESS (limit_conn + limit_rate, sized at the zone above), because\n\
    #   limit_req counts requests. The viewer cap itself is advisory: it holds for an honest client.\n\
    #   A refusal (429) is logged at `warn`, not `error`: it is the limit doing its job, not a fault.\n\
    # - A 404 (absent, or LIVE_ENABLED off) is kept 10 s, so a repeated miss costs one upstream call.\n\
    # - `X-Canari-Cache` says HIT or MISS; the access log shows `urt=- ust=-` on a hit - the proof that a\n\
    #   second viewer never reached media-service.\n\
    # - CORS as the API errors do: the three WebView origins, allowlisted, credentials allowed, so the\n\
    #   app may fetch it either way; the web app is same-origin and needs none.\n\
    location ^~ /api/media/public/live/ {\n\
    location ~ "^/api/media/public/live/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\z" {\n\
    limit_except GET { deny all; }\n\
    limit_req zone=lives_segments burst=60 nodelay;\n\
    limit_req_status 429;\n\
    limit_req_log_level warn;\n\
    limit_conn lives_segments_conn 24;\n\
    limit_conn_status 429;\n\
    limit_conn_log_level warn;\n\
    limit_rate 750000;\n\
    proxy_cache live_segments;\n\
    proxy_cache_key $uri;\n\
    proxy_cache_valid 200 2m;\n\
    proxy_cache_valid 404 10s;\n\
    proxy_cache_lock on;\n\
    proxy_cache_lock_timeout 10s;\n\
    proxy_cache_lock_age 10s;\n\
    proxy_buffering on;\n\
    proxy_force_ranges on;\n\
    proxy_ignore_headers Cache-Control Expires Set-Cookie Vary X-Accel-Expires;\n\
    proxy_hide_header Cache-Control;\n\
    proxy_hide_header Set-Cookie;\n\
    proxy_hide_header Vary;\n\
    proxy_hide_header Access-Control-Allow-Origin;\n\
    proxy_hide_header Access-Control-Allow-Credentials;\n\
    proxy_set_header X-User-Id "";\n\
    proxy_set_header X-User-Logged-In "false";\n\
    proxy_set_header X-Global-Admin "false";\n\
    proxy_set_header X-Internal-Token "";\n\
    proxy_set_header X-Session-Id "";\n\
    proxy_set_header Cookie "";\n\
    proxy_set_header Authorization "";\n\
    proxy_set_header Origin "";\n\
    proxy_set_header Range "";\n\
    proxy_set_header If-Range "";\n\
    set $upstream_media_live media-service:3011;\n\
    proxy_pass http://$upstream_media_live$uri;\n\
    proxy_http_version 1.1;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    add_header Cache-Control "private, max-age=120";\n\
    add_header X-Canari-Cache $upstream_cache_status always;\n\
    add_header Access-Control-Allow-Origin $api_error_cors_origin always;\n\
    add_header Access-Control-Allow-Credentials "true" always;\n\
    add_header Vary "Origin" always;\n\
    include /etc/nginx/snippets/csp.conf;\n\
    add_header X-Content-Type-Options "nosniff" always;\n\
    add_header X-Frame-Options "DENY" always;\n\
    }\n\
    include /etc/nginx/snippets/api-error-headers.conf;\n\
    return 404 "{\\"statusCode\\":404,\\"message\\":\\"not found\\"}";\n\
    }\n\
