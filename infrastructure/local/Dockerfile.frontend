# ── Runtime: Nginx, point d'entree public ────────────────────────────────────
# Le build Svelte est effectué en amont par le CI (job build-frontend) avec les
# secrets injectés (VITE_JWT_SECRET) et BUILD_WEB=1, qui selectionne
# adapter-node. L'artifact compilé est téléchargé dans frontend/build/ avant que
# cette image soit construite.
# NE PAS rebuilder ici : le secret ne serait pas disponible dans ce contexte.
# Et `--build` sur ce service NE RECONSTRUIT RIEN : cette image n'est qu'une COPY
# de `frontend/build`, donc Docker rend l'image de la derniere fois que quelqu'un
# a produit l'artefact, sans rien dire. `make local-frontend` est le seul chemin
# qui rafraichit les deux images ; le detail et la mesure sont dans
# Dockerfile.frontend-ssr, qui porte exactement le meme piege.
#
# adapter-node produit build/client (les assets), build/prerendered (robots.txt,
# sitemap.xml, .well-known/) et un serveur Node. Nginx sert les deux premiers
# exactement comme avant - memes en-tetes de cache, meme correctif MIME .mjs -
# et ne delegue au conteneur frontend-ssr que les navigations HTML, les seules a
# avoir besoin d'un <head> calcule (cf. frontend/src/hooks.server.ts).
# Dev branch build trigger
FROM nginx:stable-alpine

COPY frontend/build/client /usr/share/nginx/html
COPY frontend/build/prerendered /usr/share/nginx/html

# adapter-static used to overwrite the base image's own index.html; adapter-node
# emits none, so the nginx welcome page survived the COPY and the index module
# served it on "/". Delete it (and its 50x companion) so nothing can ever fall
# back to it - the root is routed explicitly to @ssr below.
RUN rm -f /usr/share/nginx/html/index.html /usr/share/nginx/html/50x.html

# The Content-Security-Policy, stated ONCE and included by every block that sets
# security headers. nginx's add_header REPLACES the inherited set instead of adding
# to it, so a block that sets any header of its own loses the policy unless it
# restates it - which is why every block below that sets one restates all three.
# Verbatim copies is how a policy drifts: two get a new host, the third silently
# keeps blocking it, so the CSP itself is included rather than retyped.
#
# THE RULE WAS STATED HERE AND NOT APPLIED, which is why it is now a gate
# (.github/scripts/tests/static-headers.test.mjs). Measured on production
# 2026-09-16: four blocks set a Cache-Control and stopped there, so the emoji font,
# every content-hashed bundle, every .mjs worker and both App Link manifests were
# served with NO nosniff and NO X-Frame-Options - while an HTML page, which reaches
# @ssr and declared nothing, inherited all three correctly. A convention that only
# holds where someone remembered it is the thing a test is for.
#
# connect-src is the list of hosts the APP ITSELF calls, and it must match the code:
#   - api.klipy.com    the GIF picker's search/trending API (GifPickerModal)
#   - static.klipy.com the GIF BYTES, fetched to be encrypted before upload
#     (PostComments.stageMediaFile). Omitting it blocked every GIF comment, silently.
# img-src stays wide (https:) because it renders arbitrary user-posted image URLs;
# connect-src must not, since it governs what the app can read into memory.
RUN mkdir -p /etc/nginx/snippets && printf 'add_header Content-Security-Policy "default-src '"'"'self'"'"'; script-src '"'"'self'"'"' '"'"'wasm-unsafe-eval'"'"' '"'"'unsafe-inline'"'"' https://js.stripe.com; script-src-elem '"'"'self'"'"' '"'"'unsafe-inline'"'"' https://js.stripe.com; style-src '"'"'self'"'"' '"'"'unsafe-inline'"'"'; connect-src '"'"'self'"'"' blob: wss: ws: https://api.stripe.com https://merchant-ui-api.stripe.com https://r.stripe.com https://js.stripe.com https://api.klipy.com https://static.klipy.com; img-src '"'"'self'"'"' data: blob: https:; font-src '"'"'self'"'"' data:; worker-src '"'"'self'"'"' blob:; media-src '"'"'self'"'"' blob:; frame-src '"'"'self'"'"' https://js.stripe.com https://hooks.stripe.com https://checkout.stripe.com; form-action '"'"'self'"'"' https://checkout.stripe.com; object-src '"'"'none'"'"'; frame-ancestors '"'"'none'"'"'; base-uri '"'"'self'"'"';" always;\n' > /etc/nginx/snippets/csp.conf

# SPA fallback + reverse proxy WebSocket/API vers les services Docker
RUN printf 'server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    # Limite d\'upload pour les médias (évite les 413 nginx par défaut ~1MB)\n\
    client_max_body_size 100m;\n\
    gzip on;\n\
    gzip_types application/json;\n\
    gzip_min_length 256;\n\
    proxy_buffering off;\n\
    tcp_nodelay on;\n\
    \n\
    # Utilise le resolver DNS interne de Docker pour la résolution des upstreams\n\
    # Cela évite que nginx refuse de démarrer si un upstream est temporairement absent\n\
    resolver 127.0.0.11 valid=10s ipv6=off;\n\
    # A CLIENT MAY SEND ANY HEADER IT LIKES, AND nginx FORWARDS THE ONES NOBODY OVERRODE.\n\
    # These four names are what the services READ to decide who is calling, so they are\n\
    # emptied here and re-set from the auth sub-request in each guarded location. The list\n\
    # must be the app-facing spelling, not the sub-request's: `auth_request_set` reads\n\
    # `X-Logged-In` off /internal/auth/verify and forwards it as `X-User-Logged-In`, and\n\
    # until 2026-09-17 this block cleared the FORMER - a name no service has ever read -\n\
    # while leaving the latter untouched. `X-Internal-Token` was not here at all.\n\
    #\n\
    # NOTHING WAS EXPLOITABLE, AND THE REASON IS NOT THIS BLOCK. nginx inherits a\n\
    # proxy_set_header set only into a location that declares NONE of its own, and all 24\n\
    # proxying locations declare theirs - so these lines currently reach nothing. They are\n\
    # the net for the NEXT location somebody adds, which is exactly when a half-empty net\n\
    # is discovered. `auth-request-coverage.test.mjs` asserts the four names are all here.\n\
    proxy_set_header X-User-Id "";\n\
    proxy_set_header X-User-Logged-In "false";\n\
    proxy_set_header X-Global-Admin "false";\n\
    proxy_set_header X-Internal-Token "";\n\
    \n\
    include /etc/nginx/snippets/csp.conf;\n\
    add_header X-Content-Type-Options "nosniff" always;\n\
    add_header X-Frame-Options "DENY" always;\n\
    \n\
    location = /internal/auth/verify {\n\
    internal;\n\
    set $upstream_auth core-service:3012;\n\
    proxy_pass http://$upstream_auth/api/auth/verify;\n\
    proxy_pass_request_body off;\n\
    proxy_set_header Content-Length "";\n\
    proxy_set_header X-Original-URI $request_uri;\n\
    proxy_set_header Authorization $http_authorization;\n\
    proxy_set_header Cookie $http_cookie;\n\
    }\n\
    \n\
    # App Links Android (assetlinks.json) + Universal Links iOS\n\
    # (apple-app-site-association), prerendus dans build/.well-known/.\n\
    location /.well-known/ {\n\
    try_files $uri =404;\n\
    add_header Content-Type application/json;\n\
    add_header Cache-Control "public, max-age=3600";\n\
    include /etc/nginx/snippets/csp.conf;\n\
    add_header X-Content-Type-Options "nosniff" always;\n\
    add_header X-Frame-Options "DENY" always;\n\
    }\n\
    \n\
    location /_app/immutable/ {\n\
    try_files $uri =404;\n\
    add_header Cache-Control "public, max-age=31536000, immutable";\n\
    include /etc/nginx/snippets/csp.conf;\n\
    add_header X-Content-Type-Options "nosniff" always;\n\
    add_header X-Frame-Options "DENY" always;\n\
    }\n\
    \n\
    # nginx mime.types has no .mjs entry, so an ES module shipped as a build\n\
    # asset (the pdf.js worker) was served as application/octet-stream and the\n\
    # browser module loader refused it. A regex location wins over the prefix\n\
    # one above, so the caching has to be repeated here.\n\
    location ~* \.mjs$ {\n\
    try_files $uri =404;\n\
    default_type application/javascript;\n\
    add_header Cache-Control "public, max-age=31536000, immutable";\n\
    include /etc/nginx/snippets/csp.conf;\n\
    add_header X-Content-Type-Options "nosniff" always;\n\
    add_header X-Frame-Options "DENY" always;\n\
    }\n\
    \n\
    # The root has to be matched exactly. There is no index.html any more, so\n\
    # "try_files $uri" on "/" would test a DIRECTORY, hand the request to the\n\
    # index module and answer 403 - the one path that cannot reach @ssr on its\n\
    # own. An exact location skips that machinery entirely.\n\
    location = / {\n\
    try_files /nonexistent @ssr;\n\
    }\n\
    \n\
    # The bundled emoji font is 5.7 MB - by a wide margin the largest thing this\n\
    # origin serves - and its name is stable across deploys, so it is the one asset\n\
    # here worth a month rather than an hour. No `immutable`: the name carries no\n\
    # content hash, so a rebuilt font (docs/wiki/frontend/emoji.md records the sha256\n\
    # of the committed artefact) must stay revalidatable. nginx answers the monthly\n\
    # conditional request with a 304 off its ETag, so a returning browser downloads\n\
    # these bytes exactly once.\n\
    location /fonts/ {\n\
    try_files $uri =404;\n\
    add_header Cache-Control "public, max-age=2592000";\n\
    include /etc/nginx/snippets/csp.conf;\n\
    add_header X-Content-Type-Options "nosniff" always;\n\
    add_header X-Frame-Options "DENY" always;\n\
    }\n\
    \n\
    # No $uri/ here on purpose: every directory under the root has its own\n\
    # location, so the only thing $uri/ can still do is re-open the 403 above.\n\
    #\n\
    # WHAT THIS BLOCK ACTUALLY SERVES, AND WHY ITS HEADERS WERE INVERTED. `try_files\n\
    # $uri @ssr` means nginx answers from THIS block only when the path is a file on\n\
    # disk - the PWA icons, the web manifest, the emoji data, the emoji font. A page\n\
    # falls through to @ssr, and a named location handles the request itself, so an\n\
    # `add_header` here never reached one. The `Cache-Control: no-store` that stood\n\
    # here was therefore stamped on every immutable asset in static/ and on none of\n\
    # the HTML it was written for; it now lives in @ssr, where the page is.\n\
    #\n\
    # Measured on production 2026-09-16, and this is what it cost: the emoji font\n\
    # answered `cf-cache-status: BYPASS` with `Cache-Control: no-store`, so its\n\
    # 5 705 472 bytes crossed from the origin on EVERY page load, uncacheable by the\n\
    # browser and by the edge alike. Preloaded from app.html, it went first and held\n\
    # the link at ~477 kB/s while the 723 kB MLS binary queued behind it at 54 kB/s\n\
    # and took 13 286 ms of a 15-second start-up.\n\
    #\n\
    # The three security headers are repeated rather than inherited: nginx drops the\n\
    # server-level add_header set as soon as a location declares one of its own, and\n\
    # this block did - so every file it served was missing nosniff and X-Frame-Options\n\
    # (measured on the same day: 0 of 2 present on the font, 2 of 2 on an HTML page,\n\
    # which reaches @ssr and declares nothing). Cache-Control is deliberately NOT\n\
    # `always`: a 404 from here must not be cached, and nginx skips a non-always\n\
    # header on a 4xx.\n\
    location / {\n\
    try_files $uri @ssr;\n\
    add_header Cache-Control "public, max-age=3600";\n\
    include /etc/nginx/snippets/csp.conf;\n\
    add_header X-Content-Type-Options "nosniff" always;\n\
    add_header X-Frame-Options "DENY" always;\n\
    }\n\
    \n\
    # HTML navigations -> the SvelteKit server (adapter-node), which writes the\n\
    # per-page Open Graph tags into the shell. A failure here falls through to\n\
    # @app_shell rather than 502-ing the whole site.\n\
    location @ssr {\n\
    set $upstream_ssr frontend-ssr:3000;\n\
    proxy_pass http://$upstream_ssr;\n\
    proxy_http_version 1.1;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    proxy_read_timeout 30s;\n\
    # SvelteKit answers every page with a Link: rel=modulepreload header listing\n\
    # ~130 chunks - about 7.5 KB, where nginx allocates 4 KB for the whole\n\
    # upstream header by default. It does not truncate: it logs "upstream sent\n\
    # too big header" and answers 502, so EVERY navigation failed while the\n\
    # upstream itself was healthy. 32k leaves room for the list to grow.\n\
    proxy_buffer_size 32k;\n\
    proxy_buffers 8 32k;\n\
    proxy_busy_buffers_size 64k;\n\
    # THE PAGE MAY BE CACHED WHERE A PURGE CAN REACH IT, AND NOWHERE ELSE. That is the\n\
    # whole of `max-age=0, s-maxage=60`, and the two halves answer two different\n\
    # questions. A deploy replaces this shell with one naming different content-hashed\n\
    # chunks, and the old chunks are NOT in the new image - so a shell that outlives its\n\
    # build is a BLANK page, not an old one. A shared cache can be told to forget:\n\
    # `serve-prod.yml` purges the zone once the new containers answer. A browser cache\n\
    # cannot be told anything at all, which is why the browser's own TTL stays 0.\n\
    #\n\
    # 60 SECONDS IS THE SMALLER OF TWO NUMBERS THAT AGREE. It is the freshness budget\n\
    # `serverSeo.ts` already set itself for the same bytes ("an edited post should not\n\
    # keep previewing its old title for long"), and it is the ceiling on how long a\n\
    # stale shell could break the site if the purge ever failed to run. There is\n\
    # deliberately no `stale-while-revalidate`: it would buy hit-rate this site does not\n\
    # need and extend exactly that window.\n\
    #\n\
    # Until 2026-09-17 this said `no-store`, which was right when it was written: the\n\
    # no-store meant for the page had been sitting in `location /`, which only ever\n\
    # answers for a file on disk, and an HTML navigation carried no Cache-Control at\n\
    # all. Putting it here fixed that. What it could not know is that the origin round\n\
    # trip it made unconditional is 94 ms of every navigation, measured in the user's\n\
    # own browser. adapter-node sets no Cache-Control of its own on an SSR response, so\n\
    # this is still the only declaration and there is no second header to reconcile.\n\
    #\n\
    # The three security headers are repeated because nginx drops the whole\n\
    # server-level add_header set from a location that declares one of its own. This\n\
    # block declared none, which is how HTML kept CSP, nosniff and X-Frame-Options by\n\
    # inheritance; adding Cache-Control here would have stripped all three from every\n\
    # navigation on the site.\n\
    add_header Cache-Control "public, max-age=0, s-maxage=60" always;\n\
    include /etc/nginx/snippets/csp.conf;\n\
    add_header X-Content-Type-Options "nosniff" always;\n\
    add_header X-Frame-Options "DENY" always;\n\
    error_page 502 503 504 =200 @app_shell;\n\
    }\n\
    \n\
    # NOTE: `=200` on the error_page above, and it was measured rather than chosen.\n\
    # Preserving the 5xx would be better for a crawler (a status it retries, instead of a\n\
    # 200 whose head is the generic one), and a browser runs the scripts of a 5xx body\n\
    # anyway - but Cloudflare REPLACES the body of an origin 5xx with its own\n\
    # "error code: 502" plain-text page, so the shell never reaches anyone. A degraded\n\
    # <head> is the cost of the fallback; the site being unreachable is not.\n\
    # adapter-node emits no index.html, so without this the frontend-ssr container\n\
    # being down means a 502 on EVERY navigation - the whole site, to spare the\n\
    # per-page head. app-shell.html is prerendered (routes/app-shell/) and boots the\n\
    # SPA on whatever URL was asked for, exactly as the static build always did.\n\
    # Degraded, not broken: only the injected <head> is missing.\n\
    location @app_shell {\n\
    try_files /app-shell.html =502;\n\
    add_header Cache-Control "no-store" always;\n\
    add_header X-Canari-Degraded "ssr-unavailable" always;\n\
    include /etc/nginx/snippets/csp.conf;\n\
    add_header X-Content-Type-Options "nosniff" always;\n\
    add_header X-Frame-Options "DENY" always;\n\
    }\n\
    \n\
    location /api/ws {\n\
    auth_request /internal/auth/verify;\n\
    auth_request_set $user_id $upstream_http_x_user_id;\n\
    auth_request_set $user_logged_in $upstream_http_x_logged_in;\n\
    auth_request_set $global_admin $upstream_http_x_global_admin;\n\
    auth_request_set $internal_token $upstream_http_x_internal_token;\n\
    proxy_set_header X-User-Id $user_id;\n\
    proxy_set_header X-User-Logged-In $user_logged_in;\n\
    proxy_set_header X-Global-Admin $global_admin;\n\
    proxy_set_header X-Internal-Token $internal_token;\n\
    set $upstream_gateway chat-gateway:3000;\n\
    proxy_pass http://$upstream_gateway;\n\
    proxy_http_version 1.1;\n\
    proxy_set_header Upgrade $http_upgrade;\n\
    proxy_set_header Connection "upgrade";\n\
    proxy_set_header Cookie $http_cookie;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    proxy_read_timeout 120s;\n\
    proxy_send_timeout 120s;\n\
    }\n\
    \n\
    location /api/admin {\n\
    auth_request /internal/auth/verify;\n\
    auth_request_set $user_id $upstream_http_x_user_id;\n\
    auth_request_set $user_logged_in $upstream_http_x_logged_in;\n\
    auth_request_set $global_admin $upstream_http_x_global_admin;\n\
    auth_request_set $internal_token $upstream_http_x_internal_token;\n\
    proxy_set_header X-User-Id $user_id;\n\
    proxy_set_header X-User-Logged-In $user_logged_in;\n\
    proxy_set_header X-Global-Admin $global_admin;\n\
    proxy_set_header X-Internal-Token $internal_token;\n\
    set $upstream_gateway chat-gateway:3000;\n\
    proxy_pass http://$upstream_gateway;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    }\n\
    \n\
    location /api/presence {\n\
    auth_request /internal/auth/verify;\n\
    auth_request_set $user_id $upstream_http_x_user_id;\n\
    auth_request_set $user_logged_in $upstream_http_x_logged_in;\n\
    auth_request_set $global_admin $upstream_http_x_global_admin;\n\
    auth_request_set $internal_token $upstream_http_x_internal_token;\n\
    proxy_set_header X-User-Id $user_id;\n\
    proxy_set_header X-User-Logged-In $user_logged_in;\n\
    proxy_set_header X-Global-Admin $global_admin;\n\
    proxy_set_header X-Internal-Token $internal_token;\n\
    set $upstream_gateway chat-gateway:3000;\n\
    proxy_pass http://$upstream_gateway;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    }\n\
    \n\
    location = /api/chat-delivery-health {\n\
    set $upstream_delivery_health chat-delivery-service:3010;\n\
    proxy_pass http://$upstream_delivery_health/api/health;\n\
    proxy_http_version 1.1;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    }\n\
    \n\
    location = /api/version {\n\
    set $upstream_version core-service:3012;\n\
    proxy_pass http://$upstream_version/api/version;\n\
    proxy_http_version 1.1;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    }\n\
    \n\
    location /api/calls/ {\n\
    auth_request /internal/auth/verify;\n\
    auth_request_set $user_id $upstream_http_x_user_id;\n\
    auth_request_set $user_logged_in $upstream_http_x_logged_in;\n\
    auth_request_set $global_admin $upstream_http_x_global_admin;\n\
    auth_request_set $internal_token $upstream_http_x_internal_token;\n\
    proxy_set_header X-User-Id $user_id;\n\
    proxy_set_header X-User-Logged-In $user_logged_in;\n\
    proxy_set_header X-Global-Admin $global_admin;\n\
    proxy_set_header X-Internal-Token $internal_token;\n\
    set $upstream_calls chat-delivery-service:3010;\n\
    proxy_pass http://$upstream_calls;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    }\n\
    \n\
    location /api/call {\n\
    auth_request /internal/auth/verify;\n\
    auth_request_set $user_id $upstream_http_x_user_id;\n\
    auth_request_set $user_logged_in $upstream_http_x_logged_in;\n\
    auth_request_set $global_admin $upstream_http_x_global_admin;\n\
    auth_request_set $internal_token $upstream_http_x_internal_token;\n\
    proxy_set_header X-User-Id $user_id;\n\
    proxy_set_header X-User-Logged-In $user_logged_in;\n\
    proxy_set_header X-Global-Admin $global_admin;\n\
    proxy_set_header X-Internal-Token $internal_token;\n\
    set $upstream_call call-service:3004;\n\
    rewrite ^/api/call(.*) /ws$1 break;\n\
    proxy_pass http://$upstream_call;\n\
    proxy_http_version 1.1;\n\
    proxy_set_header Upgrade $http_upgrade;\n\
    proxy_set_header Connection "upgrade";\n\
    proxy_set_header Cookie $http_cookie;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    proxy_read_timeout 3600s;\n\
    proxy_send_timeout 3600s;\n\
    }\n\
    \n\
    location /api/mls/ {\n\
    auth_request /internal/auth/verify;\n\
    auth_request_set $user_id $upstream_http_x_user_id;\n\
    auth_request_set $user_logged_in $upstream_http_x_logged_in;\n\
    auth_request_set $global_admin $upstream_http_x_global_admin;\n\
    auth_request_set $internal_token $upstream_http_x_internal_token;\n\
    proxy_set_header X-User-Id $user_id;\n\
    proxy_set_header X-User-Logged-In $user_logged_in;\n\
    proxy_set_header X-Global-Admin $global_admin;\n\
    proxy_set_header X-Internal-Token $internal_token;\n\
    set $upstream_delivery chat-delivery-service:3010;\n\
    proxy_pass http://$upstream_delivery;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    }\n\
    location /api/public/ {\n\
    if ($request_method = OPTIONS) {\n\
    add_header Access-Control-Allow-Origin "*" always;\n\
    add_header Access-Control-Allow-Methods "GET, OPTIONS" always;\n\
    add_header Access-Control-Max-Age 3600 always;\n\
    add_header Content-Length 0;\n\
    return 204;\n\
    }\n\
    # THIS LOCATION OWNS ITS CORS HEADERS, AND THE UPSTREAM MAY NOT ADD MORE.\n\
    # social-service allowlists localhost and 127.0.0.1 origins and echoes them\n\
    # back with Allow-Credentials, so a request from a localhost origin left here\n\
    # carrying TWO Access-Control-Allow-Origin headers - the echo and the star.\n\
    # Two of that header is invalid: every browser blocks the response, and so\n\
    # does the universal fetch in SvelteKit, which is how it surfaced: the\n\
    # portal 503ing on every detail page in dev. One layer answers CORS here,\n\
    # and the allowlist upstream is for the credentialed routes only.\n\
    proxy_hide_header Access-Control-Allow-Origin;\n\
    proxy_hide_header Access-Control-Allow-Credentials;\n\
    add_header Access-Control-Allow-Origin "*" always;\n\
    # Strip client-supplied trust headers: this public location defines its own\n\
    # proxy_set_header directives, so nginx does NOT inherit the server-level resets.\n\
    proxy_set_header X-User-Id "";\n\
    proxy_set_header X-User-Logged-In "false";\n\
    proxy_set_header X-Global-Admin "false";\n\
    proxy_set_header X-Internal-Token "";\n\
    set $upstream_public social-service:3014;\n\
    proxy_pass http://$upstream_public;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    }\n\
    location /api/media/public/ {\n\
    # Strip client-supplied trust headers (no server-level inheritance here).\n\
    proxy_set_header X-User-Id "";\n\
    proxy_set_header X-User-Logged-In "false";\n\
    proxy_set_header X-Global-Admin "false";\n\
    proxy_set_header X-Internal-Token "";\n\
    set $upstream_media_public media-service:3011;\n\
    proxy_pass http://$upstream_media_public;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    }\n\
    location /api/media {\n\
    auth_request /internal/auth/verify;\n\
    auth_request_set $user_id $upstream_http_x_user_id;\n\
    auth_request_set $user_logged_in $upstream_http_x_logged_in;\n\
    auth_request_set $global_admin $upstream_http_x_global_admin;\n\
    auth_request_set $internal_token $upstream_http_x_internal_token;\n\
    proxy_set_header X-User-Id $user_id;\n\
    proxy_set_header X-User-Logged-In $user_logged_in;\n\
    proxy_set_header X-Global-Admin $global_admin;\n\
    proxy_set_header X-Internal-Token $internal_token;\n\
    set $upstream_media media-service:3011;\n\
    proxy_pass http://$upstream_media;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    }\n\
    \n\
    location /api/posts {\n\
    auth_request /internal/auth/verify;\n\
    auth_request_set $user_id $upstream_http_x_user_id;\n\
    auth_request_set $user_logged_in $upstream_http_x_logged_in;\n\
    auth_request_set $global_admin $upstream_http_x_global_admin;\n\
    auth_request_set $internal_token $upstream_http_x_internal_token;\n\
    proxy_set_header X-User-Id $user_id;\n\
    proxy_set_header X-User-Logged-In $user_logged_in;\n\
    proxy_set_header X-Global-Admin $global_admin;\n\
    proxy_set_header X-Internal-Token $internal_token;\n\
    set $upstream_post social-service:3014;\n\
    proxy_pass http://$upstream_post;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    }\n\
    \n\
    location /api/payments {\n\
    auth_request /internal/auth/verify;\n\
    auth_request_set $user_id $upstream_http_x_user_id;\n\
    auth_request_set $user_logged_in $upstream_http_x_logged_in;\n\
    auth_request_set $global_admin $upstream_http_x_global_admin;\n\
    auth_request_set $internal_token $upstream_http_x_internal_token;\n\
    proxy_set_header X-User-Id $user_id;\n\
    proxy_set_header X-User-Logged-In $user_logged_in;\n\
    proxy_set_header X-Global-Admin $global_admin;\n\
    proxy_set_header X-Internal-Token $internal_token;\n\
    set $upstream_payment core-service:3012;\n\
    proxy_pass http://$upstream_payment;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    }\n\
    \n\
    location /api/forms {\n\
    auth_request /internal/auth/verify;\n\
    auth_request_set $user_id $upstream_http_x_user_id;\n\
    auth_request_set $user_logged_in $upstream_http_x_logged_in;\n\
    auth_request_set $global_admin $upstream_http_x_global_admin;\n\
    auth_request_set $internal_token $upstream_http_x_internal_token;\n\
    proxy_set_header X-User-Id $user_id;\n\
    proxy_set_header X-User-Logged-In $user_logged_in;\n\
    proxy_set_header X-Global-Admin $global_admin;\n\
    proxy_set_header X-Internal-Token $internal_token;\n\
    set $upstream_form social-service:3014;\n\
    proxy_pass http://$upstream_form;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    }\n\
    \n\
    location = /api/associations/calendar/feed.ics {\n\
    # Public ICS feed - strip client-supplied trust headers (no server-level inheritance).\n\
    proxy_set_header X-User-Id "";\n\
    proxy_set_header X-User-Logged-In "false";\n\
    proxy_set_header X-Global-Admin "false";\n\
    proxy_set_header X-Internal-Token "";\n\
    set $upstream_asso social-service:3014;\n\
    proxy_pass http://$upstream_asso;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    }\n\
    \n\
    location /api/associations {\n\
    auth_request /internal/auth/verify;\n\
    auth_request_set $user_id $upstream_http_x_user_id;\n\
    auth_request_set $user_logged_in $upstream_http_x_logged_in;\n\
    auth_request_set $global_admin $upstream_http_x_global_admin;\n\
    auth_request_set $internal_token $upstream_http_x_internal_token;\n\
    proxy_set_header X-User-Id $user_id;\n\
    proxy_set_header X-User-Logged-In $user_logged_in;\n\
    proxy_set_header X-Global-Admin $global_admin;\n\
    proxy_set_header X-Internal-Token $internal_token;\n\
    set $upstream_asso social-service:3014;\n\
    proxy_pass http://$upstream_asso;\n\
    proxy_set_header Host $host;\n\
    proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    }\n\
    \n\
    location /api/moderation {\n\
    auth_request /internal/auth/verify;\n\
    auth_request_set $user_id $upstream_http_x_user_id;\n\
    auth_request_set $user_logged_in $upstream_http_x_logged_in;\n\
    auth_request_set $global_admin $upstream_http_x_global_admin;\n\
    auth_request_set $internal_token $upstream_http_x_internal_token;\n\
    proxy_set_header X-User-Id $user_id;\n\
