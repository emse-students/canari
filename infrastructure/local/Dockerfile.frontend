    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;\n\
    }\n\
    \n\
    }\n' > /etc/nginx/conf.d/default.conf

# THE CONFIGURATION ABOVE IS BUILT BY A SHELL `printf`, SO NOTHING CHECKS IT.
# A stray quote, an unbalanced brace or a directive in the wrong context builds a
# perfectly green image that then fails to start - and a frontend that will not start
# is the whole site, found by a human looking at a 502. `nginx -t` moves that failure
# to the build, where it costs a red pipeline and prod keeps serving the previous
# image. The snippets this conf includes are written by an earlier layer.
RUN nginx -t

EXPOSE 80
