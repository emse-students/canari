# -- Runtime: the SvelteKit server (adapter-node) that writes the <head> -------
# The Svelte build happens upstream, in CI (the `build-frontend` job) with
# BUILD_WEB=1, which selects adapter-node instead of adapter-static. The
# compiled artifact is downloaded into frontend/build/ before this image is
# built. DO NOT rebuild here: the VITE_* secrets are not available in this
# context.
#
# THE CONSEQUENCE, AND IT IS SILENT: `docker compose up -d --build frontend-ssr`
# rebuilds NOTHING you changed. All this image contains is a COPY of
# `frontend/build`, so Docker caches on that directory's hash and hands back the
# image built the last time somebody produced the artifact - days old, with no
# error and no warning. Measured 2026-09-14: a `--build` of this service and of
# `frontend` returned an image three days old, and the estate went on serving a
# `<head>` computed by pre-merge code while the page looked entirely current. It
# cost a wrong conclusion about a shipped fix, before the image date was read.
# `make local-frontend` is the ONLY path that refreshes this: it runs the
# SvelteKit build first, asserts the artifact has the web shape, and only then
# rebuilds the two images.
#
# This container is NOT the public entry point: nginx (the `frontend` image)
# remains the only one exposing a port. It serves HTML navigations only - the
# assets are served by nginx out of the same artifact.
#
# WHY node AND NOT bun, in a repo that is otherwise bun: this runs an
# `adapter-node` build. bun would need `svelte-adapter-bun`, which changes the
# SSR entry point and how nginx proxies to it - a deploy change, not a base-image
# swap, and one nothing here has verified against a running site. The rule this
# repo learned on Portail-etu is that a runtime move is proven on its target
# host, not in CI. Until that is done, this stays on node.
FROM node:24-alpine

WORKDIR /app
COPY frontend/build ./

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

# The head is a bonus: if the process is dead, nginx answers 502 on navigations.
# The healthcheck exists so that shows up in `docker compose ps`.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/login').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "index.js"]
