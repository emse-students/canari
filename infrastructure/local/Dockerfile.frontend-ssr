# ── Runtime: le serveur SvelteKit (adapter-node) qui ecrit le <head> ─────────
# Le build Svelte est effectue en amont par le CI (job build-frontend) avec
# BUILD_WEB=1, ce qui selectionne adapter-node au lieu d'adapter-static.
# L'artifact compile est telecharge dans frontend/build/ avant que cette image
# soit construite. NE PAS rebuilder ici : les secrets VITE_* ne sont pas
# disponibles dans ce contexte.
#
# Ce conteneur n'est PAS le point d'entree public : nginx (image `frontend`)
# reste le seul a exposer un port. Il sert les navigations HTML uniquement -
# les assets sont servis par nginx depuis le meme artifact.
FROM node:22-alpine

WORKDIR /app
COPY frontend/build ./

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

# Le head est du bonus : si le process est mort, nginx renvoie 502 sur les
# navigations. Le healthcheck sert a le voir dans `docker compose ps`.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/login').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "index.js"]
