# ── Build stage ──────────────────────────────────────────────────────────────
FROM rust:slim-bookworm AS builder

# System deps for `aws-lc-sys`, the rustls backend reqwest resolves to: it builds its C sources
# with cmake and a C++ compiler. `pkg-config`, `libssl-dev`, `libcurl4-openssl-dev` and `zlib1g-dev`
# were here for rdkafka and left with it - the lockfile carries no `openssl-sys`, `curl-sys`,
# `libz-sys` or `pkg-config` crate at all, so nothing remains to probe them.
# `--no-install-recommends` (Trivy DS-0029): the recommends add nothing these stages use (measured
# 2026-11-11: krb5-locales, libldap-common, libsasl2-modules, publicsuffix) - except `make`, which
# cmake only RECOMMENDS and the builder therefore names itself.
RUN apt-get update && apt-get install -y --no-install-recommends cmake make g++ && rm -rf /var/lib/apt/lists/*

# Reproduce the path layout `build.rs` expects: it compiles the protobufs from `libs/proto`,
# resolved relative to the crate root.
WORKDIR /build

# Copy all sources in one shot - no dummy binary: the GHA cache made it deploy the stub
# `fn main(){}` instead of the real one.
COPY libs/proto ./libs/proto
COPY apps/chat-gateway ./apps/chat-gateway

RUN cd apps/chat-gateway && cargo build --release

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM debian:bookworm-slim

# `curl` is the healthcheck's command, `ca-certificates` the trust store reqwest needs. `libssl3`
# and `zlib1g` were what rdkafka linked against dynamically and went with it.
# PAM MOVED PAST THE BASE (2026-11-27): Debian fixed CVE-2025-6020 (HIGH) in `libpam-modules 1.5.2-6+deb12u3`
# while `debian:bookworm-slim` still carried deb12u2. `apt-get upgrade` takes the fix from the security
# archive, and the `dpkg --compare-versions` fails the build if it did not, rather than ship deb12u2 under a
# green build. The upgrade also makes the image scan BUILD this file, not the base (`image-scan-targets.sh`).
# Delete both the day the base carries it: the scan says so (docs/wiki/cicd.md, container images are scanned).
RUN apt-get update && apt-get upgrade -y --no-install-recommends && apt-get install -y --no-install-recommends ca-certificates curl && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libpam-modules)" ge 1.5.2-6+deb12u3 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/apps/chat-gateway/target/release/chat-gateway /usr/local/bin/chat-gateway

EXPOSE 3000

# NON-ROOT: `nobody` (65534), present in every Debian image. The binary writes nothing to disk,
# mounts no volume and listens above 1024, so it needs no account of its own (Trivy DS-0002).
USER 65534:65534

CMD ["chat-gateway"]
