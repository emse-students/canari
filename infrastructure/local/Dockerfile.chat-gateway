# ── Build stage ──────────────────────────────────────────────────────────────
FROM rust:slim-bookworm AS builder

# System deps for `aws-lc-sys`, the rustls backend reqwest resolves to: it builds its C sources
# with cmake and a C++ compiler. `pkg-config`, `libssl-dev`, `libcurl4-openssl-dev` and `zlib1g-dev`
# were here for rdkafka and left with it - the lockfile carries no `openssl-sys`, `curl-sys`,
# `libz-sys` or `pkg-config` crate at all, so nothing remains to probe them.
RUN apt-get update && apt-get install -y cmake g++ && rm -rf /var/lib/apt/lists/*

# Reproduce the path layout `build.rs` expects: it compiles the protobufs from `libs/proto`,
# resolved relative to the crate root.
WORKDIR /build

# Copy all sources in one shot - no dummy binary: the GHA cache made it deploy the stub
# `fn main(){}` instead of the real one.
COPY libs/proto ./libs/proto
COPY apps/chat-gateway ./apps/chat-gateway

RUN cd apps/chat-gateway && cargo build --release

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM debian:bookworm-slim

# `curl` is the healthcheck's command, `ca-certificates` the trust store reqwest needs. `libssl3`
# and `zlib1g` were what rdkafka linked against dynamically and went with it.
RUN apt-get update && apt-get install -y ca-certificates curl && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/apps/chat-gateway/target/release/chat-gateway /usr/local/bin/chat-gateway

EXPOSE 3000

CMD ["chat-gateway"]
