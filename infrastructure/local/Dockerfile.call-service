# ── Build stage ──────────────────────────────────────────────────────────────
FROM rust:slim-bookworm AS builder

# `--no-install-recommends` (Trivy DS-0029): the recommends add nothing these stages use (measured
# 2026-11-11: krb5-locales, libldap-common, libsasl2-modules, publicsuffix) - except `make`, which
# cmake only RECOMMENDS and the builder therefore names itself.
RUN apt-get update && apt-get install -y --no-install-recommends cmake make pkg-config libssl-dev g++ libcurl4-openssl-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY apps/call-service ./apps/call-service

RUN cd apps/call-service && cargo build --release

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /build/apps/call-service/target/release/call-service .

ENV RUST_LOG=info
EXPOSE 3004

# NON-ROOT: `nobody` (65534), present in every Debian image. The binary writes nothing to disk,
# mounts no volume and listens above 1024, so it needs no account of its own (Trivy DS-0002).
USER 65534:65534

CMD ["./call-service"]
