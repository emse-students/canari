# -- Build stage ---------------------------------------------------------------
# bun installs, compiles and serves. The tag is literal rather than read from
# `.bun-version` because a Dockerfile cannot read a file to pick its base image -
# and a literal is what Dependabot's docker ecosystem follows, so this line stays
# current on its own. A BUN BUMP'S COST IS MEASURED, NOT ASSUMED: this line used to
# promise that a bun >= 1.4.0 "reads an existing v1 lockfile unchanged", and 1.4.0
# falsified it - it writes v3, and it REFUSES a v1 lock whose `overrides` are nested,
# because 1.3.14 had saved only the flat ones. That skipped a deploy. Regenerate every
# lock with the tag ON THIS LINE before bumping it; CI's frozen install is the proof.
FROM oven/bun:1.4.4-alpine AS builder

WORKDIR /app

# Manifest and lockfile first, so a source-only change reuses the install layer.
COPY apps/social-service/package.json apps/social-service/bun.lock ./apps/social-service/
RUN cd apps/social-service && bun install --frozen-lockfile

COPY apps/social-service ./apps/social-service
# `tsconfig.build.json`, like the three sibling services - it excludes `*.spec.ts`, so the image
# stops carrying compiled test files. This line said `tsconfig.json` until 2026-09-24, which made
# this container the ONLY typecheck of any service's specs in the whole project, and it runs after
# the merge: a type error shipped in #1006 and surfaced by killing a RELEASE. The gate that belongs
# before the merge is the `typecheck` script CI now runs for all four services.
RUN cd apps/social-service && bunx tsc -p tsconfig.build.json

# -- Production dependencies ---------------------------------------------------
# What the runtime stage ships: the production closure only. The builder installs devDependencies
# too (it needs tsc and @nestjs/cli), and copying ITS node_modules put jest, the Nest CLI, ts-jest
# and the rest next to dist/ on the image's disk, in its size, its pull time and its scan.
FROM oven/bun:1.4.4-alpine AS prod-deps

WORKDIR /app

COPY apps/social-service/package.json apps/social-service/bun.lock ./apps/social-service/
RUN cd apps/social-service && bun install --production --frozen-lockfile

# -- Runtime stage -------------------------------------------------------------
FROM oven/bun:1.4.4-alpine

WORKDIR /app

COPY --from=builder /app/apps/social-service/dist ./dist
COPY --from=prod-deps /app/apps/social-service/node_modules ./node_modules
COPY --from=builder /app/apps/social-service/package.json ./

# THE ZONE IS PINNED, not inherited from the base image: the `submissions` dates are zone-less
# `timestamp` columns written on the UTC wall clock and read back in the PROCESS's zone, so every
# reader that formats them (the anonymous week cut, the XLSX date cells) agrees only while this is UTC.
ENV TZ=UTC

EXPOSE 3014

# NON-ROOT: the image's own `bun` user (uid 1000). This service writes nothing to disk and mounts no
# volume (both compose files), and listens above 1024, so root bought it nothing (Trivy DS-0002).
USER bun

CMD ["bun", "dist/main.js"]
