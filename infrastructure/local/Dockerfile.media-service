# -- Build stage ---------------------------------------------------------------
# bun installs, compiles and serves. The tag is literal rather than read from
# `.bun-version` because a Dockerfile cannot read a file to pick its base image -
# and a literal is what Dependabot's docker ecosystem follows, so this line stays
# current on its own. Bumping it past 1.4.0 is safe: a bun >= 1.4.0 only writes
# `lockfileVersion: 2` into a lockfile it CREATES, and reads an existing v1 one
# unchanged.
FROM oven/bun:1.4.0-alpine AS builder

WORKDIR /app

# Manifest and lockfile first, so a source-only change reuses the install layer.
COPY apps/media-service/package.json apps/media-service/bun.lock ./apps/media-service/
RUN cd apps/media-service && bun install --frozen-lockfile

COPY apps/media-service ./apps/media-service
# This line was `npm run build 2>/dev/null || true` - a build that could not
# fail, with its diagnostic sent to /dev/null. It did not make a broken compile
# ship, because the missing `dist` then failed the COPY below; it made a compile
# error surface two stages later as a confusing COPY failure, with the message
# that would have explained it already thrown away.
RUN cd apps/media-service && bun run build

# -- Runtime stage -------------------------------------------------------------
FROM oven/bun:1.4.0-alpine

WORKDIR /app

COPY --from=builder /app/apps/media-service/dist ./dist
COPY --from=builder /app/apps/media-service/node_modules ./node_modules
COPY --from=builder /app/apps/media-service/package.json ./

EXPOSE 3011

CMD ["bun", "dist/main.js"]
