# -- Build stage ---------------------------------------------------------------
# bun installs, compiles and serves. The tag is literal rather than read from
# `.bun-version` because a Dockerfile cannot read a file to pick its base image -
# and a literal is what Dependabot's docker ecosystem follows, so this line stays
# current on its own. Bumping it past 1.4.0 is safe: a bun >= 1.4.0 only writes
# `lockfileVersion: 2` into a lockfile it CREATES, and reads an existing v1 one
# unchanged.
FROM oven/bun:1.3.14-alpine AS builder

WORKDIR /app

# Manifest and lockfile first, so a source-only change reuses the install layer.
COPY apps/core-service/package.json apps/core-service/bun.lock ./apps/core-service/
RUN cd apps/core-service && bun install --frozen-lockfile

COPY apps/core-service ./apps/core-service
RUN cd apps/core-service && bunx tsc -p tsconfig.build.json

# -- Runtime stage -------------------------------------------------------------
FROM oven/bun:1.3.14-alpine

WORKDIR /app

COPY --from=builder /app/apps/core-service/dist ./dist
COPY --from=builder /app/apps/core-service/node_modules ./node_modules
COPY --from=builder /app/apps/core-service/package.json ./

EXPOSE 3013

CMD ["bun", "dist/main.js"]
