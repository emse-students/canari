    "social": {
      "notRefundable": "LYDIA_REFUND_NOT_REFUNDABLE",
      "exceedsPaid": "LYDIA_REFUND_EXCEEDS_PAID",
      "inFlight": "LYDIA_REFUND_IN_FLIGHT",
      "invalid": "LYDIA_REFUND_INVALID",
      "notPending": "LYDIA_REFUND_NOT_PENDING"
    },
    "notificationTypes": {
      "issued": "lydia_refund_issued"
    }
  }
}
