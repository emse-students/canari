{
  "description": "The typed codes of Lydia enrolment lots 2 and 3 (docs/wiki/frontend/modules/payments.md), shared as data so core-service, social-service and the frontend cannot disagree on a name: each side's contract spec asserts its own constants against this file. `core` codes are answered by core-service; `social` codes by social-service; `notificationTypes` are the bell row types social-service writes. `switches` are the gates both sides must agree on (lot 3: adding a cashier, ON since 1.7.1; the Responsable hand-over, OFF until its homologation run and the owner's production trial).",
  "core": {
    "businessNotValidated": "LYDIA_BUSINESS_NOT_VALIDATED",
    "businessBlocked": "LYDIA_BUSINESS_BLOCKED",
    "signatureRefused": "LYDIA_SIGNATURE_REFUSED",
    "cashierPermissionsInvalid": "LYDIA_CASHIER_PERMISSIONS_INVALID",
    "businessTokenRejected": "LYDIA_BUSINESS_TOKEN_REJECTED",
    "cashierNotConfigured": "LYDIA_CASHIER_NOT_CONFIGURED",
    "unreachable": "LYDIA_UNREACHABLE",
    "cashierRightsIncomplete": "LYDIA_CASHIER_RIGHTS_INCOMPLETE",
    "cashierPhoneInvalid": "LYDIA_CASHIER_PHONE_INVALID",
    "responsableNotAMember": "LYDIA_RESPONSABLE_NOT_A_MEMBER",
    "responsableNotACashier": "LYDIA_RESPONSABLE_NOT_A_CASHIER",
    "noBusiness": "LYDIA_NO_BUSINESS",
    "cashierAddDisabled": "LYDIA_CASHIER_ADD_DISABLED",
    "cashierRevokeUnconfirmed": "LYDIA_CASHIER_REVOKE_UNCONFIRMED",
    "cashierReadbackInvalid": "LYDIA_CASHIER_READBACK_INVALID",
    "cashierRemovalPrecondition": "LYDIA_CASHIER_REMOVAL_PRECONDITION",
    "responsableNumberChangeForbidden": "LYDIA_RESPONSABLE_NUMBER_CHANGE_FORBIDDEN",
    "responsableHandoverDisabled": "LYDIA_RESPONSABLE_HANDOVER_DISABLED"
  },
  "social": {
    "paymentsNotActivated": "PAYMENTS_NOT_ACTIVATED",
    "paymentsBlocked": "PAYMENTS_BLOCKED",
    "enrolmentInFlight": "LYDIA_ENROLMENT_IN_FLIGHT",
    "enrolmentPending": "LYDIA_ENROLMENT_PENDING",
    "businessPendingValidation": "LYDIA_BUSINESS_PENDING_VALIDATION",
    "businessHoldsPayments": "LYDIA_BUSINESS_HOLDS_PAYMENTS",
    "responsableAlreadySet": "LYDIA_RESPONSABLE_ALREADY_SET",
    "responsablePhoneLocked": "LYDIA_RESPONSABLE_PHONE_LOCKED",
    "responsableInFlight": "LYDIA_RESPONSABLE_IN_FLIGHT",
    "businessChanged": "LYDIA_BUSINESS_CHANGED",
    "cashierInFlight": "LYDIA_CASHIER_IN_FLIGHT",
    "cashierNotAMember": "LYDIA_CASHIER_NOT_A_MEMBER",
    "cashierAlreadySet": "LYDIA_CASHIER_ALREADY_SET",
    "cashierPhoneInUse": "LYDIA_CASHIER_PHONE_IN_USE",
    "cashierNoResponsable": "LYDIA_CASHIER_NO_RESPONSABLE",
    "cashierResponsableNumber": "LYDIA_CASHIER_RESPONSABLE_NUMBER",
    "cashierNotFound": "LYDIA_CASHIER_NOT_FOUND",
    "cashierRoleFixed": "LYDIA_CASHIER_ROLE_FIXED",
    "cashierClaimLost": "LYDIA_CASHIER_CLAIM_LOST",
    "cashierNumberChanged": "LYDIA_CASHIER_NUMBER_CHANGED",
    "cashierConfirmedRequired": "LYDIA_CASHIER_CONFIRMED_REQUIRED",
    "cashiersLiveOnDelete": "LYDIA_CASHIERS_LIVE",
    "responsableHandoverForbidden": "LYDIA_RESPONSABLE_HANDOVER_FORBIDDEN",
    "responsableHandoverSamePerson": "LYDIA_RESPONSABLE_HANDOVER_SAME_PERSON",
    "responsableMustHandOver": "LYDIA_RESPONSABLE_MUST_HAND_OVER"
  },
  "notificationTypes": {
    "active": "lydia_payments_active",
    "paused": "lydia_payments_paused",
    "cashierAdded": "lydia_cashier_added"
  },
  "switches": {
    "cashierAddEnabled": true,
    "responsableHandoverEnabled": false
  },
  "timeouts": {
    "description": "How long social-service waits for core-service's verified removal of ONE cashier number (an erasure's or a departure's) before it records the outcome NOT confirmed and releases the cashier claim. core bounds each of the removal's three Lydia calls so their sum stays under it (LYDIA_REMOVAL_STEP_TIMEOUT_MS), asserted by each side's spec.",
    "cashierRemovalWaitMs": 30000
  },
  "refund": {
    "description": "Lydia refunds (lot 4, docs/wiki/frontend/modules/payments.md \"Refunds\"). `core` codes are answered by core-service's internal refund route, `social` codes by social-service's refund routes; the frontend words each one. `notificationTypes` is the payer's bell row.",
    "core": {
      "noKey": "LYDIA_REFUND_NO_KEY",
      "notRefundableAtLydia": "LYDIA_REFUND_TRANSACTION_NOT_REFUNDABLE",
      "notAllowed": "LYDIA_REFUND_NOT_ALLOWED",
      "rejected": "LYDIA_REFUND_REJECTED",
      "unconfirmed": "LYDIA_REFUND_UNCONFIRMED"
    },
    "social": {
