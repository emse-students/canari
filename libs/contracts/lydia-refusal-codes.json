  "refund": {
    "description": "Lydia refunds (lot 4, docs/wiki/frontend/modules/payments.md \"Refunds\"). `core` codes are answered by core-service's internal refund route, `social` codes by social-service's refund routes; the frontend words each one. `notificationTypes` is the payer's bell row.",
    "core": {
      "noKey": "LYDIA_REFUND_NO_KEY",
      "notRefundableAtLydia": "LYDIA_REFUND_TRANSACTION_NOT_REFUNDABLE",
      "notAllowed": "LYDIA_REFUND_NOT_ALLOWED",
